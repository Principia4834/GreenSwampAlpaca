<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.greenswamp.alpaca.server</string>

    <key>ProgramArguments</key>
    <array>
      <string>/Applications/GreenSwampAlpaca.app/Contents/MacOS/GreenSwamp.Alpaca.Server</string>
      <string>--service</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Applications/GreenSwampAlpaca.app/Contents/MacOS</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/greenswamp-alpaca.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/greenswamp-alpaca.err.log</string>
  </dict>
</plist>
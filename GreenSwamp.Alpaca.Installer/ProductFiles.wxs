<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
	<?define ComponentRules="OneToOne"?>
	<!-- SourceDir is set from the PublishDir preprocessor variable passed by the wixproj/CI -->
	<Fragment>
		<ComponentGroup Id="GreenSwampAlpacaServerFiles">
			<!-- XML files -->
			<Files Directory="INSTALLDIR" Include="$(var.PublishDir)\*.xml" />
			<!-- DLL files -->
			<Files Directory="INSTALLDIR" Include="$(var.PublishDir)\*.dll" />
			<!-- json files -->
			<Files Directory="INSTALLDIR" Include="$(var.PublishDir)\*.json" />
			<Component Directory="INSTALLDIR">
				<File Source="$(var.PublishDir)\cio_ra.bin" KeyPath="yes" />
			</Component>
			<Component Directory="INSTALLDIR">
				<File Source="$(var.PublishDir)\JPLEPH" KeyPath="yes" />
			</Component>
			<Component Directory="INSTALLDIR">
				<File Source="$(var.PublishDir)\web.config" KeyPath="yes" />
			</Component>
			<Component Directory="INSTALLDIR" Subdirectory="wwwroot\_content\ASCOM.Alpaca.Razor">
				<File Source="$(var.PublishDir)\wwwroot\_content\ASCOM.Alpaca.Razor\background.png" KeyPath="yes" />
			</Component>
			<!-- Blazor framework files -->
			<Files Directory="INSTALLDIR" Subdirectory="wwwroot\_framework" Include="$(var.PublishDir)\wwwroot\_framework\*.gz" />
			<!-- Blazor css files -->
			<Files Directory="INSTALLDIR" Subdirectory="wwwroot\css" Include="$(var.PublishDir)\wwwroot\css\*.gz" />
			<!-- MudBlazor files -->
			<Files Directory="INSTALLDIR" Subdirectory="wwwroot\_content\MudBlazor" Include="$(var.PublishDir)\wwwroot\_content\MudBlazor\*.gz" />
			<!-- Blazor-ApexCharts css files -->
			<Files Directory="INSTALLDIR" Subdirectory="wwwroot\_content\Blazor-ApexCharts\css" Include="$(var.PublishDir)\wwwroot\_content\Blazor-ApexCharts\css\*.gz" />
			<!-- Blazor-ApexCharts js files -->
			<Files Directory="INSTALLDIR" Subdirectory="wwwroot\_content\Blazor-ApexCharts\js" Include="$(var.PublishDir)\wwwroot\_content\Blazor-ApexCharts\js\*.gz" />
			<!-- Blazor-ApexCharts locales -->
			<Component Directory="INSTALLDIR" Subdirectory="wwwroot\_content\Blazor-ApexCharts\locales">
				<File Source="$(var.PublishDir)\wwwroot\_content\Blazor-ApexCharts\locales\en.json.gz" KeyPath="yes" />
			</Component>
			<Component Directory="INSTALLDIR" Subdirectory="wwwroot\_content\Blazor-ApexCharts\locales">
				<File Source="$(var.PublishDir)\wwwroot\_content\Blazor-ApexCharts\locales\fr.json.gz" KeyPath="yes" />
			</Component>
			<Component Directory="INSTALLDIR" Subdirectory="wwwroot\_content\Blazor-ApexCharts\locales">
				<File Source="$(var.PublishDir)\wwwroot\_content\Blazor-ApexCharts\locales\de.json.gz" KeyPath="yes" />
			</Component>
			<Component Directory="INSTALLDIR" Subdirectory="wwwroot\_content\Blazor-ApexCharts\locales">
				<File Source="$(var.PublishDir)\wwwroot\_content\Blazor-ApexCharts\locales\it.json.gz" KeyPath="yes" />
			</Component>
			<Component Directory="INSTALLDIR" Subdirectory="wwwroot\_content\Blazor-ApexCharts\locales">
				<File Source="$(var.PublishDir)\wwwroot\_content\Blazor-ApexCharts\locales\es.json.gz" KeyPath="yes" />
			</Component>
			<Component Directory="INSTALLDIR" Subdirectory="wwwroot">
				<File Source="$(var.PublishDir)\wwwroot\favicon.ico.gz" KeyPath="yes" />
			</Component>
			<!-- Font files -->
			<Files Directory="INSTALLDIR" Subdirectory="wwwroot\fonts" Include="$(var.PublishDir)\wwwroot\fonts\*.woff2" />
			<!-- Background home page image -->
			<Component Directory="INSTALLDIR" Subdirectory="wwwroot\images">
				<File Source="$(var.PublishDir)\wwwroot\images\GreenSwamp1.webp" KeyPath="yes" />
			</Component>
			<!-- Carousel images files -->
			<Files Directory="INSTALLDIR" Subdirectory="wwwroot\images\carousel\astronomy" Include="$(var.PublishDir)\wwwroot\images\carousel\astronomy\*.jpg" />
			<!-- Local script files required by app -->
			<Files Directory="INSTALLDIR" Subdirectory="wwwroot\js" Include="$(var.PublishDir)\wwwroot\js\*.gz" />
			<!-- Tree-shaken Babylon.js bundle required by TelescopeView (built from tools\babylon-build) -->
			<!-- Packaged under wwwroot\lib\babylon so the app does not depend on the CDN at runtime -->
			<Files Directory="INSTALLDIR" Subdirectory="wwwroot\lib\babylon" Include="$(var.PublishDir)\wwwroot\lib\babylon\*.gz" />
			<!-- 3D Model files-->
			<Files Directory="INSTALLDIR" Subdirectory="wwwroot\model3d" Include="$(var.PublishDir)\wwwroot\model3d\*.png" />
			<Files Directory="INSTALLDIR" Subdirectory="wwwroot\model3d\backgrounds" Include="$(var.PublishDir)\wwwroot\model3d\backgrounds\*.jpg" />
			<Files Directory="INSTALLDIR" Subdirectory="wwwroot\model3d\models" Include="$(var.PublishDir)\wwwroot\model3d\models\*.obj" />

		</ComponentGroup>
		<Feature Id="UserApp" />
	</Fragment>
</Wix>

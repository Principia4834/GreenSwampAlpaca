@using GreenSwamp.Alpaca.Server.Components.Dialogs
@using GreenSwamp.Alpaca.MountControl;
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudNavMenu>
    @* Mount actions*@
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">@Loc["Nav_Home"]</MudNavLink>

    <MudNavLink Href="/mount-control" Icon="@Icons.Material.Filled.Navigation">@Loc["Nav_Control"]</MudNavLink>
    <MudNavLink Href="/mount-status" Icon="@Icons.Material.Filled.DisplaySettings">@Loc["Nav_Status"]</MudNavLink>
    <MudNavLink Href="/mount-configuration" Icon="@Icons.Material.Filled.TravelExplore">@Loc["Nav_Configuration"]</MudNavLink>
    <MudNavLink Href="/monitor" Icon="@Icons.Material.Filled.ListAlt">@Loc["Nav_Monitor"]</MudNavLink>

    <MudDivider Class="my-2" />

    @* Settings actions *@
    <MudNavLink Href="/settings-explorer" Icon="@Icons.Material.Filled.AccountTree">@Loc["Nav_SettingsExplorer"]</MudNavLink>
    <MudNavLink Href="/check-settings" Icon="@Icons.Material.Filled.MonitorHeart">@Loc["Nav_CheckSettings"]</MudNavLink>

    <MudDivider Class="my-2" />

    @* Shutdown action *@
    <MudNavLink Icon="@Icons.Material.Filled.PowerSettingsNew"
                IconColor="Color.Error"
                Class="shutdown-nav-link"
                OnClick="OpenShutdownDialogAsync">@Loc["Nav_Shutdown"]</MudNavLink>

</MudNavMenu>

@code {
    [Inject] private IDialogService DialogService { get; set; } = default!;

    private async Task OpenShutdownDialogAsync()
    {
        await ShutdownDialogHelper.ShowShutdownDialogAsync(
            DialogService,
            Snackbar,
            Program.Lifetime,
            Loc);
    }

    private async Task OpenChartWindowAsync(string url, string windowKey)
    {
        await JS.InvokeVoidAsync(
            "chartWindowInterop.open",
            DotNetObjectReference.Create(this),
            url,
            windowKey,
            1200,
            700);
    }

    [JSInvokable]
    public void OnPopupBlocked(string url)
    {
        Snackbar.Add(
            Loc["Nav_ChartPopupBlocked"],
            Severity.Warning);
    }

    [JSInvokable]
    public void OnChartWindowClosed(string windowKey)
    {
        // Chart window closed externally — no nav-menu state to update.
    }
}

@using System.Globalization
@using GreenSwamp.Alpaca.Server.Components.About
@using GreenSwamp.Alpaca.Server.Services
@using GreenSwamp.Alpaca.Server.Theme
@using GreenSwamp.Alpaca.Settings.Services

@inherits LayoutComponentBase
@implements IDisposable
@inject FloatingWindowManager WindowManager
@inject NavigationManager NavigationManager
@inject TelescopeStateService TelescopeStateService
@inject IVersionedSettingsService SettingsService
@inject IDialogService DialogService

<HeadContent>
    <style>
        @RootFontSizeStyle
    </style>
</HeadContent>

<MudThemeProvider Theme="@GsTheme.Instance" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<GlobalNotificationsHost />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true"
               Style="background-color:var(--gs-bg-sidebar); border-bottom:1px solid var(--gs-divider);">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                       Edge="Edge.Start" OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Style="font-weight:300; letter-spacing:0.01em; font-size:1.4rem;">
            <span style="font-weight:700; color:var(--gs-accent-500);">GS</span>Alpaca
        </MudText>

        <!-- Displays current Date and Time -->
        <MudSpacer />
        <MudText Typo="Typo.h6" Color="Color.Primary">@CurrentDateTimeString</MudText>

        <MudSpacer />
        <MudButton Color="Color.Primary" Variant="Variant.Filled" 
                   StartIcon="@Icons.Material.Filled.Help" 
                   OnClick="OpenAboutDialog">
                   Help
        </MudButton>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="DrawerVariant.Responsive"
               Breakpoint="Breakpoint.LgAndDown"
               ClipMode="DrawerClipMode.Always"
               Width="200px"
               Style="background-color:var(--gs-bg-sidebar); border-right:1px solid rgba(var(--gs-accent-500-rgb),0.2);">
        <NavMenu />
        <MudText Typo="Typo.h3" Class="mt-auto pa-3">
            Version @(ServerConfig.GetVersion())
        </MudText>
    </MudDrawer>

        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>

<!-- Renders globally over all views without reset boundaries -->
<PersistentFloatingWindow />

@code {
    private bool _drawerOpen = true;
    private double _fontScale = GsZoom.DefaultScale;

    private string RootFontSizeStyle => GsZoom.BuildRootStyle(_fontScale);

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task OpenAboutDialog()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = false,
            CloseOnEscapeKey = true,
            CloseButton = true,
            Position = DialogPosition.Center
        };
        await DialogService.ShowAsync<AboutDialog>("", options);
    }

    private string CurrentDateTimeString { get; set; } = string.Empty;
    private Timer? _timer;

    protected override void OnInitialized()
    {
        SettingsService.ServerConfigChanged += OnServerConfigChanged;
        ApplyServerConfig(SettingsService.GetServerConfig());

        // Update immediately on load
        UpdateDateTime();

        // Create a timer that ticks every 1000 ms (1 second)
        _timer = new Timer(Callback, null, TimeSpan.Zero, TimeSpan.FromMilliseconds(1000));

        base.OnInitialized();
    }

    private void ApplyServerConfig(GreenSwamp.Alpaca.Settings.Models.ServerConfig config)
    {
        _fontScale = GsZoom.NormalizeScale(config.GlobalFontScale);
    }

    private void OnServerConfigChanged(object? sender, GreenSwamp.Alpaca.Settings.Models.ServerConfig config)
    {
        _ = InvokeAsync(() =>
        {
            ApplyServerConfig(config);
            StateHasChanged();
        });
    }

    private void UpdateDateTime()
    {
        // Customise the date and time format string here
        CurrentDateTimeString = DateTime.Now.ToString("dd MMM yyyy  HH:mm:ss", CultureInfo.CurrentCulture);
        StateHasChanged(); // Refresh the UI
    }

    private void Callback(object? state)
    {
        InvokeAsync(() => UpdateDateTime());
    }

    public void Dispose()
    {
        SettingsService.ServerConfigChanged -= OnServerConfigChanged;
        _timer?.Dispose();
    }
}

@using System.Globalization
@using Microsoft.AspNetCore.WebUtilities
@using GreenSwamp.Alpaca.Server.Components.About
@using GreenSwamp.Alpaca.Server.Services
@using GreenSwamp.Alpaca.Server.Theme
@using GreenSwamp.Alpaca.Settings.Services

@inherits LocalizedLayoutComponentBase
@implements IDisposable
@inject FloatingWindowManager WindowManager
@inject NavigationManager NavigationManager
@inject TelescopeStateService TelescopeStateService
@inject IVersionedSettingsService SettingsService
@inject IDialogService DialogService
@inject BrowserCultureService BrowserCultureService
@inject BrowserTtsService BrowserTtsService
@inject IThemeService ThemeService

<HeadContent>
    <style>
        @RootFontSizeStyle
    </style>
</HeadContent>

<MudThemeProvider Theme="@GsTheme.Get(ThemeService.Current)" IsDarkMode="@ThemeService.Current.IsDark" ObserveSystemDarkModeChange="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<GlobalNotificationsHost />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true"
               Style="background-color:var(--gs-bg-sidebar); border-bottom:1px solid var(--gs-divider);">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                       Edge="Edge.Start" OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h5" Class="gs-brand">
            <span style="font-weight:700; color:var(--gs-accent);">GS</span>Alpaca
        </MudText>

        <!-- Displays current Date and Time -->
        <MudSpacer />
        <MudText Typo="Typo.h6" Color="Color.Tertiary">@CurrentDateTimeString</MudText>

        <MudSpacer />
        <MudButton Color="Color.Primary" Variant="Variant.Filled" 
                   StartIcon="@Icons.Material.Filled.Help" 
                   OnClick="OpenAboutDialog">
                   @Loc["Layout_Help"]
        </MudButton>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="DrawerVariant.Responsive"
               Breakpoint="Breakpoint.LgAndDown"
               ClipMode="DrawerClipMode.Always"
               Width="12.5rem"
               Style="background-color:var(--gs-bg-sidebar); border-right:1px solid var(--gs-divider);">
        <NavMenu />
        <MudText Typo="Typo.caption" Class="mt-auto pa-3">
            @Loc["Layout_Version", ServerConfig.GetVersion()]
        </MudText>
    </MudDrawer>

        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>

<!-- Renders globally over all views without reset boundaries -->
<PersistentFloatingWindow />

@code {
    private bool _drawerOpen = true;
    private double _fontScale = GsZoom.DefaultScale;

    private double EffectiveFontScale => ThemeService.ZoomPercent is { } percent ? percent / 100.0 : _fontScale;

    private string RootFontSizeStyle => GsZoom.BuildRootStyle(EffectiveFontScale);

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void OnThemeChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task OpenAboutDialog()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = false,
            CloseOnEscapeKey = true,
            CloseButton = true,
            Position = DialogPosition.Center
        };
        await DialogService.ShowAsync<AboutDialog>("", options);
    }

    private string CurrentDateTimeString { get; set; } = string.Empty;
    private Timer? _timer;

    protected override void OnInitialized()
    {
        SettingsService.ServerConfigChanged += OnServerConfigChanged;
        ThemeService.Changed += OnThemeChanged;
        ThemeService.DisplayChanged += OnThemeChanged;
        ApplyServerConfig(SettingsService.GetServerConfig());

        // Update immediately on load
        UpdateDateTime();

        // Create a timer that ticks every 1000 ms (1 second)
        _timer = new Timer(Callback, null, TimeSpan.Zero, TimeSpan.FromMilliseconds(1000));

        base.OnInitialized();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ThemeService.InitializeAsync();
        }

        if (!firstRender || await BrowserCultureService.HasCulturePreferenceAsync())
        {
            return;
        }

        await BrowserCultureService.MarkInitializationAttemptedAsync();

        var browserCulture = await BrowserTtsService.GetLanguageAsync();
        var returnUrl = new Uri(NavigationManager.Uri).PathAndQuery;
        var endpoint = NavigationManager.ToAbsoluteUri("culture/set").ToString();
        var target = QueryHelpers.AddQueryString(endpoint, new Dictionary<string, string?>
        {
            ["initialize"] = "true",
            ["browserCulture"] = browserCulture,
            ["returnUrl"] = returnUrl
        });

        NavigationManager.NavigateTo(target, forceLoad: true);
    }

    private void ApplyServerConfig(GreenSwamp.Alpaca.Settings.Models.ServerConfig config)
    {
        _fontScale = GsZoom.NormalizeScale(config.GlobalFontScale);
    }

    private void OnServerConfigChanged(object? sender, GreenSwamp.Alpaca.Settings.Models.ServerConfig config)
    {
        _ = InvokeAsync(() =>
        {
            ApplyServerConfig(config);
            StateHasChanged();
        });
    }

    private void UpdateDateTime()
    {
        // Customise the date and time format string here
        CurrentDateTimeString = DateTime.Now.ToString("dd MMM yyyy  HH:mm:ss", CultureInfo.CurrentCulture);
        StateHasChanged(); // Refresh the UI
    }

    private void Callback(object? state)
    {
        InvokeAsync(() => UpdateDateTime());
    }

    public void Dispose()
    {
        SettingsService.ServerConfigChanged -= OnServerConfigChanged;
        ThemeService.Changed -= OnThemeChanged;
        ThemeService.DisplayChanged -= OnThemeChanged;
        _timer?.Dispose();
    }
}

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">About</MudText>
    </TitleContent>

    <DialogContent>
        <MudTabs Elevation="0" Rounded="true" Border="true" Style="min-width: 640px; max-width: 760px;">
            <MudTabPanel Text="About">
                <MudPaper Elevation="0" Class="pa-3" Style="max-height: 360px; overflow: auto;">
                    <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@_aboutText</MudText>
                </MudPaper>
            </MudTabPanel>

            <MudTabPanel Text="License">
                <MudPaper Elevation="0" Class="pa-3" Style="max-height: 360px; overflow: auto;">
                    <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@_licenseText</MudText>
                </MudPaper>
            </MudTabPanel>

            <MudTabPanel Text="Credits">
                <MudPaper Elevation="0" Class="pa-3" Style="max-height: 360px; overflow: auto;">
                    <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@_creditsText</MudText>
                </MudPaper>
            </MudTabPanel>
        </MudTabs>
    </DialogContent>

    <DialogActions>
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="width: 100%;">
            <MudStack Row="true" Spacing="1">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Href="https://example.com/help"
                           Target="_blank"
                           Rel="noopener noreferrer"
                           StartIcon="@Icons.Material.Filled.HelpCenter">
                    Online Help
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Href="https://example.com/alpaca"
                           Target="_blank"
                           Rel="noopener noreferrer"
                           StartIcon="@Icons.Material.Filled.Info">
                    Alpaca
                </MudButton>
            </MudStack>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Default"
                       OnClick="Close">
                Close
            </MudButton>
        </MudStack>
    </DialogActions>
</MudDialog>

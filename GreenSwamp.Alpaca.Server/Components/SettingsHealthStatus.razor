@using GreenSwamp.Alpaca.Settings.Services
@using GreenSwamp.Alpaca.Settings.Models
@using System.Net
@inject IVersionedSettingsService SettingsService
@inject IHttpContextAccessor HttpContextAccessor

@{
    var cardColor = _validationResult?.HasErrors == true ? Color.Error
                  : _validationResult?.HasWarnings == true ? Color.Warning
                  : Color.Success;
}

<MudCard Outlined="true" Style="@($"border-color: var(--mud-palette-{cardColor.ToString().ToLower()})")">
    <MudCardHeader>
        <CardHeaderContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@(_validationResult?.HasErrors == true ? Icons.Material.Filled.Warning
                              : _validationResult?.HasWarnings == true ? Icons.Material.Filled.Info
                              : Icons.Material.Filled.CheckCircle)"
                         Color="@cardColor" />
                <MudText Typo="Typo.h6">@Loc["Health_Title"]</MudText>
            </MudStack>
        </CardHeaderContent>
    </MudCardHeader>

    <MudCardContent>
        @if (_loading)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                <MudText Typo="Typo.body1">@Loc["Health_Validating"]</MudText>
            </MudStack>
        }
        else if (_validationResult != null)
        {
            @if (_validationResult.IsValid)
            {
                <MudAlert Severity="Severity.Success" Class="mb-3">
                    <strong>@Loc["Health_AllValid"]</strong>
                    @if (_validationResult.HasWarnings)
                    {
                        <span> @Loc["Health_WarningCount", _validationResult.Warnings.Count]</span>
                    }
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">
                    <strong>@Loc["Health_Failed"]</strong> @Loc["Health_ErrorsFound", _validationResult.Errors.Count]
                </MudAlert>
            }

            <MudText Typo="Typo.caption" Class="mb-3">
                <strong>@Loc["Health_SettingsFile"]</strong> <code>@SettingsService.MonitorSettingsPath</code>
            </MudText>

            @if (_validationResult.HasErrors)
            {
                <MudText Typo="Typo.subtitle2" Color="Color.Error" Class="mb-2">
                    @Loc["Health_Errors", _validationResult.Errors.Count]
                </MudText>
                @foreach (var error in _validationResult.Errors)
                {
                    <MudCard Outlined="true" Class="mb-2" Style="border-color: var(--mud-palette-error)">
                        <MudCardContent Class="pa-3">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                                <MudStack Row="true" Spacing="1">
                                    <MudChip T="string" Color="Color.Error" Size="Size.Small">@error.ErrorCode</MudChip>
                                    @if (error.DeviceNumber.HasValue)
                                    {
                                        <MudChip T="string" Color="Color.Default" Size="Size.Small">@Loc["Health_Device", error.DeviceNumber]</MudChip>
                                    }
                                </MudStack>
                                @if (error.IsAutoRepairable)
                                {
                                    <MudChip T="string" Color="Color.Info" Size="Size.Small">@Loc["Health_AutoRepairable"]</MudChip>
                                }
                            </MudStack>
                            <MudText Typo="Typo.body1" Class="mt-1">@error.Message</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary"><strong>@Loc["Health_Resolution"]</strong> @error.Resolution</MudText>
                        </MudCardContent>
                    </MudCard>
                }
            }

            @if (_validationResult.HasWarnings)
            {
                <MudText Typo="Typo.subtitle2" Color="Color.Warning" Class="mb-2 mt-3">
                    @Loc["Health_Warnings", _validationResult.Warnings.Count]
                </MudText>
                @foreach (var warning in _validationResult.Warnings)
                {
                    <MudCard Outlined="true" Class="mb-2" Style="border-color: var(--mud-palette-warning)">
                        <MudCardContent Class="pa-3">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                                <MudStack Row="true" Spacing="1">
                                    <MudChip T="string" Color="Color.Warning" Size="Size.Small">@warning.ErrorCode</MudChip>
                                    @if (warning.DeviceNumber.HasValue)
                                    {
                                        <MudChip T="string" Color="Color.Default" Size="Size.Small">@Loc["Health_Device", warning.DeviceNumber]</MudChip>
                                    }
                                </MudStack>
                                @if (warning.IsAutoRepairable)
                                {
                                    <MudChip T="string" Color="Color.Info" Size="Size.Small">@Loc["Health_AutoRepairable"]</MudChip>
                                }
                            </MudStack>
                            <MudText Typo="Typo.body1" Class="mt-1">@warning.Message</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary"><strong>@Loc["Health_Resolution"]</strong> @warning.Resolution</MudText>
                        </MudCardContent>
                    </MudCard>
                }
            }

            <MudStack Row="true" Spacing="2" Class="mt-3">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="RefreshValidation" Disabled="_loading">
                    @Loc["Health_Revalidate"]
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.FolderOpen"
                           OnClick="OpenSettingsFile"
                           Disabled="@(!_isLocalRequest || SettingsPathResolver.IsService)">
                    @Loc["Health_OpenFolder"]
                </MudButton>
            </MudStack>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3">
                @Loc.Html("Health_Unable")
            </MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="RefreshValidation">
                @Loc["Health_Revalidate"]
            </MudButton>
        }
    </MudCardContent>
</MudCard>


@code {
    private ValidationResult? _validationResult;
    private bool _loading = true;
    private bool _isLocalRequest;

    protected override void OnInitialized()
    {
        var connection = HttpContextAccessor.HttpContext?.Connection;
        _isLocalRequest = connection?.RemoteIpAddress is { } remote
            && (IPAddress.IsLoopback(remote) || remote.Equals(connection.LocalIpAddress));

        ValidateSettings();
    }

    private void ValidateSettings()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            _validationResult = SettingsService.ValidateDeviceSettings(0);
        }
        catch (Exception ex)
        {
            _validationResult = new ValidationResult
            {
                IsValid = false,
                ErrorMessage = Loc["Health_ValidationError", ex.Message]
            };
            _validationResult.Errors.Add(new ValidationError
            {
                ErrorCode = "VALIDATION_EXCEPTION",
                Severity = "error",
                Message = Loc["Health_UnexpectedError", ex.Message],
                Resolution = Loc["Health_CheckLogs"],
                IsAutoRepairable = false
            });
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void RefreshValidation()
    {
        ValidateSettings();
    }

    private void OpenSettingsFile()
    {
        var directory = System.IO.Path.GetDirectoryName(SettingsService.MonitorSettingsPath);
        if (string.IsNullOrEmpty(directory) || !System.IO.Directory.Exists(directory)) return;

        try
        {
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
            {
                FileName        = directory,
                UseShellExecute = true,
                Verb            = "open"
            });
        }
        catch
        {
            // Non-critical UI operation — silently ignore
        }
    }
}

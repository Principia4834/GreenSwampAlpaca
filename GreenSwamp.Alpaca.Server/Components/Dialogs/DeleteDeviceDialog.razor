@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.DeleteForever" Color="Color.Error" />
            <MudText Typo="Typo.h6" Color="Color.Error">@Loc["DeleteDevice_Title"]</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3" Class="mt-2">
            <MudAlert Severity="Severity.Error" Icon="@Icons.Material.Filled.Warning">
                <MudText Typo="Typo.body1">
                    <strong>@Loc["DeleteDevice_CannotUndo"]</strong>
                </MudText>
                <MudText Typo="Typo.body2" Class="mt-1">
                    @Loc.Html("DeleteDevice_Removal", DeviceNumber, DeviceName)
                </MudText>
            </MudAlert>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @Loc.Html("DeleteDevice_Hint")
            </MudText>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Filled" Color="Color.Default">
            @Loc["Common_Cancel"]
        </MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.DeleteForever"
                   OnClick="Confirm">
            @Loc["DeleteDevice_Delete"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public int DeviceNumber { get; set; }
    [Parameter] public string DeviceName { get; set; } = string.Empty;

    private void Confirm() => MudDialog.Close(DialogResult.Ok(true));
    private void Cancel()  => MudDialog.Cancel();
}

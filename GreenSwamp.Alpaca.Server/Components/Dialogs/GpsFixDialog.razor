@using GreenSwamp.Alpaca.Server.Services
@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.GpsFixed" Color="Color.Primary" />
            <MudText Typo="Typo.h6">@Loc["Gps_Title"]</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3" Class="mt-2" Style="min-width: 20rem">
            @if (_reading)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
                    <MudText Typo="Typo.body1">@Loc["Gps_Reading", ConnectionParams.Port]</MudText>
                </MudStack>
            }
            else if (_error is not null)
            {
                <MudAlert Severity="Severity.Warning" Icon="@Icons.Material.Filled.GpsOff">
                    @_error
                </MudAlert>
            }
            else if (_result is not null)
            {
                <MudSimpleTable Dense="true">
                    <tbody>
                        <tr>
                            <td>@Loc["Gps_Nmea"]</td>
                            <td>@_result.NmeaTag</td>
                        </tr>
                        <tr>
                            <td>@Loc["Common_Latitude"]</td>
                            <td>@_result.Latitude.ToString("F6", System.Globalization.CultureInfo.InvariantCulture)&deg;</td>
                        </tr>
                        <tr>
                            <td>@Loc["Common_Longitude"]</td>
                            <td>@_result.Longitude.ToString("F6", System.Globalization.CultureInfo.InvariantCulture)&deg;</td>
                        </tr>
                        <tr>
                            <td>@Loc["Common_Altitude"]</td>
                            <td>@_result.Altitude.ToString("F1") m</td>
                        </tr>
                        <tr>
                            <td>@Loc["Gps_GpsUtc"]</td>
                            <td>@(_result.GpsUtc?.ToString("yyyy-MM-dd HH:mm:ss.fff") ?? Loc["Gps_NotReported"].Value)</td>
                        </tr>
                        <tr>
                            <td>@Loc["Gps_PcUtc"]</td>
                            <td>@_result.PcUtc.ToString("yyyy-MM-dd HH:mm:ss.fff")</td>
                        </tr>
                        <tr>
                            <td>@Loc["Gps_TimeDifference"]</td>
                            <td>@FormatTimeDiff(_result.TimeDiff)</td>
                        </tr>
                    </tbody>
                </MudSimpleTable>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">
            @(_result is null ? Loc["Common_Close"] : Loc["Common_Cancel"])
        </MudButton>
        @if (_result is not null)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Check"
                       OnClick="Apply">
                @Loc["Common_Apply"]
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    private string FormatTimeDiff(TimeSpan? diff)
    {
        if (diff is null) return Loc["Gps_NoTimestamp"];
        var seconds = diff.Value.TotalSeconds;
        return seconds >= 0
            ? Loc["Gps_Ahead", seconds]
            : Loc["Gps_Behind", -seconds];
    }
}

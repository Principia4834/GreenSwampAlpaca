@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Refresh" Color="Color.Warning" />
            <MudText Typo="Typo.h6">@Loc["HotReload_Title"]</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3" Class="mt-2">
            @if (ConnectedDevices.Count > 0)
            {
                <MudAlert Severity="Severity.Error" Icon="@Icons.Material.Filled.LinkOff">
                    <MudText Typo="Typo.body1">
                        <strong>@Loc["HotReload_Disconnect", ConnectedDevices.Count]</strong>
                    </MudText>
                    <MudStack Spacing="0" Class="mt-1">
                        @foreach (var name in ConnectedDevices)
                        {
                            <MudText Typo="Typo.body2">&bull;&nbsp;@name</MudText>
                        }
                    </MudStack>
                </MudAlert>
            }

            <MudAlert Severity="Severity.Warning" Icon="@Icons.Material.Filled.Warning">
                <MudText Typo="Typo.body2">
                    @Loc["HotReload_Warning"]
                </MudText>
            </MudAlert>

            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @Loc["HotReload_Hint"]
            </MudText>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Filled" Color="Color.Default">
            @Loc["Common_Cancel"]
        </MudButton>
        <MudButton Color="Color.Warning" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="Confirm">
            @Loc["HotReload_Apply"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Names of devices that are currently connected, shown in the warning list.</summary>
    [Parameter] public List<string> ConnectedDevices { get; set; } = [];

    private void Confirm() => MudDialog.Close(DialogResult.Ok(true));
    private void Cancel()  => MudDialog.Cancel();
}

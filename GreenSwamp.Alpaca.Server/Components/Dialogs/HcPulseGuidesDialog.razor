@using GreenSwamp.Alpaca.Settings.Models
@using GreenSwamp.Alpaca.Settings.Services
@using GreenSwamp.Alpaca.Server.Components.SettingsGroups
@inject IVersionedSettingsService SettingsService

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Settings" Color="Color.Primary" />
            <MudText Typo="Typo.h6">HC Settings — Device @DeviceNumber</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudTabs Rounded="true" Outlined="true" KeepPanelsAlive="true" Elevation="0">
            <MudTabPanel Text="Axis Settings">
                <MudStack Spacing="1" Class="pt-2">
                    <MudCheckBox @bind-Value="_flipEw"
                                 @bind-Value:after="() => OnHandControllerOptionChanged(HcOption.FlipEw)"
                                 T="bool"
                                 Dense="true"
                                 Label="Flip RA/Az" />
                    <MudCheckBox @bind-Value="_flipNs"
                                 @bind-Value:after="() => OnHandControllerOptionChanged(HcOption.FlipNs)"
                                 T="bool"
                                 Dense="true"
                                 Label="Flip Dec/Alt" />
                    <MudCheckBox @bind-Value="_antiRa"
                                 @bind-Value:after="() => OnHandControllerOptionChanged(HcOption.AntiRa)"
                                 T="bool"
                                 Dense="true"
                                 Label="Anti-backlash RA/Az" />
                    <MudCheckBox @bind-Value="_antiDec"
                                 @bind-Value:after="() => OnHandControllerOptionChanged(HcOption.AntiDec)"
                                 T="bool"
                                 Dense="true"
                                 Label="Anti-backlash Dec/Alt" />
                </MudStack>
            </MudTabPanel>

            <MudTabPanel Text="Pulse Guide Rates">
                <MudStack Spacing="2" Class="pt-2">
                    <HcPulseGuidesEditor Guides="@_working"
                                         MaxRate="@MaxRate"
                                         OnChanged="@OnEditorChanged" />

                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                        <MudButton OnClick="Cancel" Variant="Variant.Filled" Color="Color.Default">
                            Cancel
                        </MudButton>
                        <MudButton OnClick="SaveAsync"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@(!_isDirty)"
                                   StartIcon="@Icons.Material.Filled.Save">
                            Save
                        </MudButton>
                    </MudStack>
                </MudStack>
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
</MudDialog>
@using GreenSwamp.Alpaca.MountControl
@using GreenSwamp.Alpaca.Settings.Services
@using GreenSwamp.Alpaca.Server.Components.Dialogs
@using Microsoft.JSInterop
@using MudBlazor
@inject IJSRuntime JS
@inject IVersionedSettingsService SettingsService
@inject IDialogService DialogService
@implements IAsyncDisposable

<div>
    <MudStack Spacing="3">
        <MudStack Class="hc-primary-controls" Spacing="2">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                @* 3x3 Direction Grid *@
                <div class="hc-grid" @ref="_gridElement">
                    @* Row 1: NW, N, NE *@
                    <MudButton class="@(GetButtonClass("NorthWest"))" data-hc-dir="NorthWest" title="@Loc["HandCtl_NorthWest"]" disabled="@(!IsEnabled)">
                        <MudIcon Icon="@Icons.Material.Filled.NorthWest" />
                    </MudButton>
                    <MudButton class="@(GetButtonClass("North"))" data-hc-dir="North" title="@Loc["HandCtl_North"]" disabled="@(!IsEnabled)">
                        <MudIcon Icon="@Icons.Material.Filled.North" />
                    </MudButton>
                    <MudButton class="@(GetButtonClass("NorthEast"))" data-hc-dir="NorthEast" title="@Loc["HandCtl_NorthEast"]" disabled="@(!IsEnabled)">
                        <MudIcon Icon="@Icons.Material.Filled.NorthEast" />
                    </MudButton>

                    @* Row 2: W, Stop, E *@
                    <MudButton class="@(GetButtonClass("West"))" data-hc-dir="West" title="@Loc["HandCtl_West"]" disabled="@(!IsEnabled)">
                        <MudIcon Icon="@Icons.Material.Filled.West" />
                    </MudButton>
                    <MudButton class="hc-btn hc-stop" data-hc-stop="true" title="@Loc["Common_Stop"]" disabled="@(!IsEnabled)">
                        <MudIcon Icon="@Icons.Material.Filled.StopCircle" Color="Color.Error" Size="Size.Large" />
                    </MudButton>
                    <MudButton class="@(GetButtonClass("East"))" data-hc-dir="East" title="@Loc["HandCtl_East"]" disabled="@(!IsEnabled)">
                        <MudIcon Icon="@Icons.Material.Filled.East" />
                    </MudButton>

                    @* Row 3: SW, S, SE *@
                    <MudButton class="@(GetButtonClass("SouthWest"))" data-hc-dir="SouthWest" title="@Loc["HandCtl_SouthWest"]" disabled="@(!IsEnabled)">
                        <MudIcon Icon="@Icons.Material.Filled.SouthWest" />
                    </MudButton>
                    <MudButton class="@(GetButtonClass("South"))" data-hc-dir="South" title="@Loc["HandCtl_South"]" disabled="@(!IsEnabled)">
                        <MudIcon Icon="@Icons.Material.Filled.South" />
                    </MudButton>
                    <MudButton class="@(GetButtonClass("SouthEast"))" data-hc-dir="SouthEast" title="@Loc["HandCtl_SouthEast"]" disabled="@(!IsEnabled)">
                        <MudIcon Icon="@Icons.Material.Filled.SouthEast" />
                    </MudButton>
                </div>

                @* Speed Slider — vertical, beside direction grid *@
                <MudTooltip Text="@Loc["HandCtl_SpeedTooltip"]">
                    <MudStack Class="hc-speed-column"
                              Spacing="0"
                              AlignItems="AlignItems.Center"
                              Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body1" Align="Align.Center" Class="hc-speed-label">@Loc["HandCtl_Speed", _speed]</MudText>
                        <div class="hc-speed-slider-slot">
                            <MudSlider @bind-Value="_speed"
                                       @bind-Value:after="OnSpeedChanged"
                                       T="int" Min="1" Max="8" Step="1" TickMarks="true" Size="Size.Large"
                                       Vertical="true"
                                       Disabled="@(!IsEnabled)"
                                       Class="hc-speed-slider" />
                        </div>
                    </MudStack>
                </MudTooltip>
            </MudStack>

            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start" Class="hc-secondary-controls">
                <MudStack Spacing="1" Class="hc-secondary-options">
                    <MudTooltip Text="@Loc["HandCtl_OneClickTooltip"]">
                        <MudCheckBox @bind-Value="_oneClickStart" @bind-Value:after="OnOneClickStartChanged" T="bool" Dense="true" Label="@Loc["HandCtl_OneClickStart"]" Disabled="@(!IsEnabled)" />
                    </MudTooltip>
                    <MudTooltip Text="@Loc["HandCtl_KeysOffTooltip"]">
                        <MudCheckBox @bind-Value="_disableKeysOnGoTo" @bind-Value:after="OnDisableKeysOnGoToChanged" T="bool" Dense="true" Label="@Loc["HandCtl_KeysOff"]" Disabled="@(!IsEnabled)" />
                    </MudTooltip>
                </MudStack>
                <div class="hc-secondary-settings">
                    <MudTooltip Text="@Loc["HandCtl_EditTooltip"]" Placement="Placement.Right" Arrow="true">
                        <MudIconButton Icon="@Icons.Material.Filled.Settings"
                                       Color="Color.Primary"
                                       Size="Size.Large"
                                       OnClick="OpenHcPulseGuidesDialogAsync"
                                       Disabled="@(!IsEnabled)" />
                    </MudTooltip>
                </div>
            </MudStack>
        </MudStack>


        @* Mode Selector + Pulse Guides gear button on one row *@
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
            <MudToggleGroup @bind-Value="_mode"
                            @bind-Value:after="OnModeChanged"
                            Color="Color.Primary"
                            Size="Size.Small"
                            SelectionMode="SelectionMode.SingleSelection"
                            Disabled="@(!IsEnabled)">
            <MudTooltip Text="@Loc["HandCtl_AxesTooltip"]">
                    <MudToggleItem Value="@HcMode.Axes" Text="@Loc["HandCtl_Axes"]" Class="mud-width-full rounded-0" />
            </MudTooltip>
            <MudTooltip Text="@Loc["HandCtl_GuidingTooltip"]">
                    <MudToggleItem Value="@HcMode.Guiding" Text="@Loc["HandCtl_Guiding"]" Class="mud-width-full rounded-0" />
            </MudTooltip>
            <MudTooltip Text="@Loc["HandCtl_PulseTooltip"]">
                    <MudToggleItem Value="@HcMode.Pulse" Text="@Loc["HandCtl_Pulse"]" Class="mud-width-full rounded-0" />
            </MudTooltip>
            </MudToggleGroup>
        </MudStack>
    </MudStack>
</div>

@using GreenSwamp.Alpaca.MountControl
@using GreenSwamp.Alpaca.Settings.Services
@using GreenSwamp.Alpaca.Server.Components.Dialogs
@using Microsoft.JSInterop
@using MudBlazor
@inject IJSRuntime JS
@inject IVersionedSettingsService SettingsService
@inject IDialogService DialogService
@implements IAsyncDisposable

<div>
    <MudStack Spacing="3">
        <MudStack Class="hc-primary-controls" Spacing="2">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                @* 3x3 Direction Grid *@
                <div class="hc-grid" @ref="_gridElement">
                    @* Row 1: NW, N, NE *@
                    <MudButton class="@(GetButtonClass("NorthWest"))" data-hc-dir="NorthWest" title="North-West" disabled="@(!IsEnabled)">
                        <MudIcon Icon="@Icons.Material.Filled.NorthWest" />
                    </MudButton>
                    <MudButton class="@(GetButtonClass("North"))" data-hc-dir="North" title="North" disabled="@(!IsEnabled)">
                        <MudIcon Icon="@Icons.Material.Filled.North" />
                    </MudButton>
                    <MudButton class="@(GetButtonClass("NorthEast"))" data-hc-dir="NorthEast" title="North-East" disabled="@(!IsEnabled)">
                        <MudIcon Icon="@Icons.Material.Filled.NorthEast" />
                    </MudButton>

                    @* Row 2: W, Stop, E *@
                    <MudButton class="@(GetButtonClass("West"))" data-hc-dir="West" title="West" disabled="@(!IsEnabled)">
                        <MudIcon Icon="@Icons.Material.Filled.West" />
                    </MudButton>
                    <MudButton class="hc-btn hc-stop" data-hc-stop="true" title="Stop" disabled="@(!IsEnabled)">
                        <MudIcon Icon="@Icons.Material.Filled.StopCircle" Color="Color.Error" Size="Size.Large" />
                    </MudButton>
                    <MudButton class="@(GetButtonClass("East"))" data-hc-dir="East" title="East" disabled="@(!IsEnabled)">
                        <MudIcon Icon="@Icons.Material.Filled.East" />
                    </MudButton>

                    @* Row 3: SW, S, SE *@
                    <MudButton class="@(GetButtonClass("SouthWest"))" data-hc-dir="SouthWest" title="South-West" disabled="@(!IsEnabled)">
                        <MudIcon Icon="@Icons.Material.Filled.SouthWest" />
                    </MudButton>
                    <MudButton class="@(GetButtonClass("South"))" data-hc-dir="South" title="South" disabled="@(!IsEnabled)">
                        <MudIcon Icon="@Icons.Material.Filled.South" />
                    </MudButton>
                    <MudButton class="@(GetButtonClass("SouthEast"))" data-hc-dir="SouthEast" title="South-East" disabled="@(!IsEnabled)">
                        <MudIcon Icon="@Icons.Material.Filled.SouthEast" />
                    </MudButton>
                </div>

                @* Speed Slider — vertical, beside direction grid *@
                <MudTooltip Text="Hand controller motion speed">
                    <MudStack Class="hc-speed-column"
                              Spacing="0"
                              AlignItems="AlignItems.Center"
                              Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body1" Align="Align.Center" Class="hc-speed-label">Speed: @_speed</MudText>
                        <div class="hc-speed-slider-slot">
                            <MudSlider @bind-Value="_speed"
                                       @bind-Value:after="OnSpeedChanged"
                                       T="int"
                                       Min="1"
                                       Max="8"
                                       Step="1"
                                       TickMarks="true"
                                       Size="Size.Large"
                                       Vertical="true"
                                       Disabled="@(!IsEnabled)"
                                       Class="hc-speed-slider" />
                        </div>
                    </MudStack>
                </MudTooltip>
            </MudStack>

            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start" Class="hc-secondary-controls">
                <MudStack Spacing="1" Class="hc-secondary-options">
                    <MudTooltip Text="One click starts and stops motion">
                        <MudCheckBox @bind-Value="_oneClickStart" @bind-Value:after="OnOneClickStartChanged" T="bool" Dense="true" Label="One Click Start" Disabled="@(!IsEnabled)" />
                    </MudTooltip>
                    <MudTooltip Text="Keys disabled while slewing">
                        <MudCheckBox @bind-Value="_disableKeysOnGoTo" @bind-Value:after="OnDisableKeysOnGoToChanged" T="bool" Dense="true" Label="Keys Off for Go To" Disabled="@(!IsEnabled)" />
                    </MudTooltip>
                </MudStack>
                <div class="hc-secondary-settings">
                    <MudTooltip Text="Edit hand controller settings" Placement="Placement.Right" Arrow="true">
                        <MudIconButton Icon="@Icons.Material.Filled.Settings"
                                       Color="Color.Primary"
                                       Size="Size.Large"
                                       OnClick="OpenHcPulseGuidesDialogAsync"
                                       Disabled="@(!IsEnabled)" />
                    </MudTooltip>
                </div>
            </MudStack>
        </MudStack>


        @* Mode Selector + Pulse Guides gear button on one row *@
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
            <MudToggleGroup @bind-Value="_mode"
                            @bind-Value:after="OnModeChanged"
                            Color="Color.Primary"
                            Size="Size.Small"
                            SelectionMode="SelectionMode.SingleSelection"
                            Disabled="@(!IsEnabled)">
                <MudToggleItem Value="@HcMode.Axes" Text="Axes" />
                <MudToggleItem Value="@HcMode.Guiding" Text="Guiding" />
                <MudToggleItem Value="@HcMode.Pulse" Text="Pulse" />
            </MudToggleGroup>
        </MudStack>

        @if (!string.IsNullOrEmpty(_statusMessage))
        {
            <MudAlert Severity="Severity.Info" Dense="true">@_statusMessage</MudAlert>
        }

    </MudStack>
</div>

@using GreenSwamp.Alpaca.Server.Models
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@implements IDisposable

<MudStack Spacing="2">

    @* -- Axis dials ------------------------------------------------------- *@
    <MudStack Row="true" Justify="Justify.FlexStart" Spacing="4" Wrap="Wrap.Wrap" Class="mt-1">
        @if (_coordMode == CoordMode.AltAz)
        {
            <AxisDial Angle="@State.Azimuth" Label="@Loc["MountInfo_Azimuth"]" Size="@DialSize" />
            <AxisDial Angle="@State.Altitude" Label="@Loc["MountInfo_Altitude"]" Size="@DialSize" />
        }
        @if (_coordMode == CoordMode.RaDec)
        {
            <AxisDial Angle="@(State.RightAscension * 15)" Label="@Loc["MountInfo_RightAscension"]"
                      DisplayUnits="DialDisplayUnits.Hours" Size="@DialSize" />
            <AxisDial Angle="@State.Declination" Label="@Loc["MountInfo_Declination"]" Size="@DialSize" />
        }
        @if (_coordMode == CoordMode.Optics)
        {
            <AxisDial Angle="@State.ActualAxisX" Label="@Loc["MountInfo_XAxis"]" Size="@DialSize" />
            <AxisDial Angle="@State.ActualAxisY" Label="@Loc["MountInfo_YAxis"]" Size="@DialSize" />
        }
    </MudStack>

    @* -- Dial type selection ---------------------------------------------- *@
    <MudToggleGroup T="CoordMode" @bind-Value="_coordMode" Size="Size.Small" Color="Color.Primary"
                    SelectionMode="SelectionMode.SingleSelection">
            <MudTooltip Text="@Loc["MountInfo_RaDecTooltip"]">
                <MudToggleItem Value="CoordMode.RaDec" Text="@Loc["MountInfo_RaDec"]" Class="mud-width-full rounded-0" />
            </MudTooltip>
            <MudTooltip Text="@Loc["MountInfo_AltAzTooltip"]">
                <MudToggleItem Value="CoordMode.AltAz" Text="@Loc["MountInfo_AltAz"]" Class="mud-width-full rounded-0" />
            </MudTooltip>
            <MudTooltip Text="@Loc["MountInfo_OpticsTooltip"]">
                <MudToggleItem Value="CoordMode.Optics" Text="@Loc["MountInfo_Optics"]" Class="mud-width-full rounded-0" />
            </MudTooltip>
    </MudToggleGroup>

    @* -- Chart / view buttons: one full-width row -------------------------- *@
    <MudStack Row="true" Spacing="2" Style="width:100%">
       <MudTooltip Text="@Loc["MountInfo_AxesChartTooltip"]">
            <MudButton Color="Color.Primary"
                       Variant="Variant.Outlined"
                       Class="flex-grow-1"
                       Disabled="@(!IsConnected)"
                       OnClick="@(() => OpenChartWindowAsync("radec"))">
                @Loc["MountInfo_AxesChart"]
            </MudButton>
       </MudTooltip>
        <MudTooltip Text="@Loc["MountInfo_PulseChartTooltip"]">
           <MudButton Color="Color.Primary"
                   Variant="Variant.Outlined"
                   Class="flex-grow-1"
                   Disabled="@(!IsConnected)"
                   OnClick="@(() => OpenChartWindowAsync("pulse"))">
            @Loc["MountInfo_PulseChart"]
            </MudButton>
       </MudTooltip>
        <MudTooltip Text="@Loc["MountInfo_View3DTooltip"]">
            <MudButton Color="Color.Primary"
                   Variant="Variant.Outlined"
                   Class="flex-grow-1"
                   Disabled="@(!IsConnected)"
                   OnClick="OpenTelescopeViewAsync">
            @Loc["MountInfo_View3D"]
            </MudButton>
       </MudTooltip>
    </MudStack>

</MudStack>

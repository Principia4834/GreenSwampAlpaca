@using GreenSwamp.Alpaca.Settings.Models

<MudGrid Spacing="2">
    <MudItem xs="12" md="8">
        <MudStack Spacing="3">
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Set_ServerName_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudTextField @bind-Value="Config.Location"
                              @bind-Value:after="NotifyChanged"
                              Label="@Loc["Set_ServerName"]" Immediate="true" />
            </MudTooltip>
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Set_ServerPort_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudNumericField T="ushort" @bind-Value="Config.ServerPort"
                                  @bind-Value:after="NotifyChanged"
                                  Label="@Loc["Set_ServerPort"]"
                                  Min="1" Max="65535" Class="mb-1" Immediate="true" />
            </MudTooltip>
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Set_AllowRemoteAccess_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudCheckBox @bind-Value="Config.AllowRemoteAccess"
                             @bind-Value:after="NotifyChanged"
                             Label="@Loc["Set_AllowRemoteAccess"]" Color="Color.Primary" />
            </MudTooltip>
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Set_LocalRespondOnlyToLocalHost_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudCheckBox @bind-Value="Config.LocalRespondOnlyToLocalHost"
                             @bind-Value:after="NotifyChanged"
                             Label="@Loc["Set_LocalRespondOnlyToLocalHost"]" Color="Color.Primary" />
            </MudTooltip>
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Set_AllowDiscovery_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudCheckBox @bind-Value="Config.AllowDiscovery"
                             @bind-Value:after="NotifyChanged"
                             Label="@Loc["Set_AllowDiscovery"]" Color="Color.Primary" />
            </MudTooltip>
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Set_StrictAlpaca_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudCheckBox @bind-Value="Config.RunInStrictAlpacaMode"
                             @bind-Value:after="NotifyChanged"
                             Label="@Loc["Set_StrictAlpaca"]" Color="Color.Primary" />
            </MudTooltip>
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Set_PreventRemoteDisconnects_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudCheckBox @bind-Value="Config.PreventRemoteDisconnects"
                             @bind-Value:after="NotifyChanged"
                             Label="@Loc["Set_PreventRemoteDisconnects"]" Color="Color.Primary" />
            </MudTooltip>
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Set_EnableSwagger_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudCheckBox @bind-Value="Config.RunSwagger"
                             @bind-Value:after="NotifyChanged"
                             Label="@Loc["Set_EnableSwagger"]" Color="Color.Primary" />
            </MudTooltip>
        </MudStack>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudPaper Class="pa-3" Style="height:100%;">
            <MudText Typo="Typo.subtitle2" Class="mb-2">@Loc["Set_ServerAddresses"]</MudText>
            @if (Config.AllowRemoteAccess)
            {
                <MudStack Spacing="0">
                    @try
                    {
                        @foreach (var address in ASCOM.Alpaca.DiscoveryManager.AdapterAddress)
                        {
                            <MudText Typo="Typo.body1">@address</MudText>
                        }
                    }
                    catch { }
                </MudStack>
            }
            else
            {
                <MudText Typo="Typo.body1">localhost</MudText>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    [Parameter] public ServerConfig Config { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private async Task NotifyChanged() => await OnChanged.InvokeAsync();
}

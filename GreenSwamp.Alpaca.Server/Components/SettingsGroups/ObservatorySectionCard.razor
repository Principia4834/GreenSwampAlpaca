@using GreenSwamp.Alpaca.Settings.Models

<MudCard Elevation="2">
    <MudCardHeader>
        <CardHeaderAvatar>
            <MudIcon Icon="@Icons.Material.Filled.LocationOn" Color="Color.Primary" />
        </CardHeaderAvatar>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">@Loc["ObsCard_Title"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @Loc["ObsCard_Description"]
            </MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            @if (IsDirty)
            {
                <MudChip T="string" Color="Color.Warning" Size="Size.Small"
                         Icon="@Icons.Material.Filled.Edit">@Loc["ObsCard_Unsaved"]</MudChip>
            }
        </CardHeaderActions>
    </MudCardHeader>

    <MudCardContent>
        @if (Observatories?.Observatories is { Count: > 0 } list)
        {
            <MudTable Items="list" Hover="true" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>@Loc["ObsCard_Name"]</MudTh>
                    <MudTh>@Loc["ObsCard_Latitude"]</MudTh>
                    <MudTh>@Loc["ObsCard_Longitude"]</MudTh>
                    <MudTh>@Loc["ObsCard_Elevation"]</MudTh>
                    <MudTh>@Loc["ObsCard_UtcOffset"]</MudTh>
                    <MudTh Style="text-align:right">@Loc["ObsCard_Actions"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@Loc["ObsCard_Name"]"><MudText Typo="Typo.body2"><strong>@context.Name</strong></MudText></MudTd>
                    <MudTd DataLabel="@Loc["Common_Latitude"]">@context.Latitude.ToString("F6", System.Globalization.CultureInfo.InvariantCulture)</MudTd>
                    <MudTd DataLabel="@Loc["Common_Longitude"]">@context.Longitude.ToString("F6", System.Globalization.CultureInfo.InvariantCulture)</MudTd>
                    <MudTd DataLabel="@Loc["ObsCard_DataElevation"]">@context.Elevation.ToString("F1")</MudTd>
                    <MudTd DataLabel="@Loc["ObsCard_DataUtcOffset"]">@context.UTCOffset.TotalHours.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)</MudTd>
                    <MudTd Style="text-align:right">
                        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="0">
                            @if (DeviceSettings is { Count: > 0 })
                            {
                                <MudTooltip Text="@Loc["ObsCard_CopyToAll"]" Placement="Placement.Left">
                                    <MudIconButton Icon="@Icons.Material.Filled.CopyAll"
                                                   Size="Size.Small" Color="Color.Secondary"
                                                   OnClick="@(() => CopyToAllDevices(context))" />
                                </MudTooltip>
                            }
                            <MudTooltip Text="@(list.Count <= 1 ? Loc["ObsCard_CannotDeleteLast"].Value : Loc["ObsCard_Delete"].Value)" Placement="Placement.Left">
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                               Size="Size.Small" Color="Color.Error"
                                               Disabled="@(list.Count <= 1)"
                                               OnClick="@(() => RequestDelete(context.Id))" />
                            </MudTooltip>
                        </MudStack>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudCardContent>

    <MudCardActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.AddLocationAlt"
                   OnClick="RequestAdd">
            @Loc["ObsCard_Add"]
        </MudButton>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   Disabled="@(!IsDirty || IsLoading)"
                   OnClick="@(() => OnSave.InvokeAsync())">
            @if (IsLoading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
            }
            @Loc["Common_Save"]
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.RestartAlt"
                   Disabled="@(!IsDirty)"
                   OnClick="@(() => OnReset.InvokeAsync())">
            @Loc["ObsCard_Reset"]
        </MudButton>
    </MudCardActions>
</MudCard>

@code {
    [Parameter] public ObservatorySettings? Observatories { get; set; }
    [Parameter] public bool IsDirty { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public Dictionary<int, SkySettings>? DeviceSettings { get; set; }

    [Parameter] public EventCallback OnAdd { get; set; }
    [Parameter] public EventCallback<string> OnDelete { get; set; }
    [Parameter] public EventCallback<ObservatoryInfo> OnCopyToAllDevices { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }

    private Task RequestAdd() => OnAdd.InvokeAsync();
    private Task RequestDelete(string id) => OnDelete.InvokeAsync(id);
    private Task CopyToAllDevices(ObservatoryInfo obs) => OnCopyToAllDevices.InvokeAsync(obs);
}

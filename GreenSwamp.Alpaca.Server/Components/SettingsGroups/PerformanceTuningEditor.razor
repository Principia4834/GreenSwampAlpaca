@using GreenSwamp.Alpaca.Settings.Models

<MudStack Spacing="3">
    <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Perf_CheckInterval_Tip"]" Placement="Placement.Right" Arrow="true">
        <MudNumericField T="int" @bind-Value="Device!.CheckInterval" @bind-Value:after="NotifyChanged"
                         Label="@Loc["Perf_CheckInterval"]" Min="100" Immediate="true" />
    </MudTooltip>
    <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Perf_GotoPrecision_Tip"]" Placement="Placement.Right" Arrow="true">
        @if (ShowHidden)
        {
            <MudNumericField T="double" @bind-Value="Device!.GotoPrecision" @bind-Value:after="NotifyChanged"
                             Label="@Loc["Perf_GotoPrecision"]" Format="F5" Converter="@(NumericFieldConverter.Localized("F5"))" Min="0.000001" Immediate="true" />
        }
    </MudTooltip>
    <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Perf_TraceLogger_Tip"]" Placement="Placement.Right" Arrow="true">
        <MudCheckBox @bind-Value="Device!.TraceLogger" @bind-Value:after="NotifyChanged"
                     Label="@Loc["Perf_TraceLogger"]" Color="Color.Primary" />
    </MudTooltip>
</MudStack>

@code {
    [Parameter] public SkySettings? Device { get; set; }
    [Parameter] public bool ShowHidden { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private async Task NotifyChanged() => await OnChanged.InvokeAsync();
}

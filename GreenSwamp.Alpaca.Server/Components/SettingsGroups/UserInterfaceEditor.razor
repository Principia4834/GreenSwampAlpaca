@using GreenSwamp.Alpaca.Settings.Models

<MudStack Spacing="3">
    <MudTooltip Inline="false" RootStyle="max-width:260px" Text="Global UI zoom level applied across the server UI." Placement="Placement.Right" Arrow="true">
        <MudSelect T="int"
                   Value="ZoomPercent"
                   ValueChanged="OnZoomPercentChanged"
                   Label="Zoom">
            @foreach (var zoom in ZoomOptions)
            {
                <MudSelectItem T="int" Value="@zoom">@($"{zoom}%")</MudSelectItem>
            }
        </MudSelect>
    </MudTooltip>

    <MudTooltip Inline="false" RootStyle="max-width:260px" Text="Display theme selection for the server UI." Placement="Placement.Right" Arrow="true">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="pa-2 mud-border rounded">
            <MudText Typo="Typo.body2">Display Theme</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Not implemented</MudText>
        </MudStack>
    </MudTooltip>

    <MudTooltip Inline="false" RootStyle="max-width:260px" Text="Language selection for the server UI." Placement="Placement.Right" Arrow="true">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="pa-2 mud-border rounded">
            <MudText Typo="Typo.body2">Language</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Not implemented</MudText>
        </MudStack>
    </MudTooltip>

    <MudTooltip Inline="false" RootStyle="max-width:260px" Text="Open the default browser automatically when the server starts." Placement="Placement.Right" Arrow="true">
        <MudCheckBox @bind-Value="Config.AutoStartBrowser"
                     @bind-Value:after="NotifyChanged"
                     Label="Auto-start Browser" Color="Color.Primary" />
    </MudTooltip>
</MudStack>

@code {
    private const int MinZoomPercent = 75;
    private const int MaxZoomPercent = 150;
    private const int ZoomStepPercent = 5;

    [Parameter] public ServerConfig Config { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private static IEnumerable<int> ZoomOptions => Enumerable.Range(0, ((MaxZoomPercent - MinZoomPercent) / ZoomStepPercent) + 1)
        .Select(index => MinZoomPercent + (index * ZoomStepPercent));

    private int ZoomPercent
    {
        get => NormalizeZoomPercent((int)Math.Round(Config.GlobalFontScale * 100.0));
        set => Config.GlobalFontScale = NormalizeZoomPercent(value) / 100.0;
    }

    private async Task OnZoomPercentChanged(int value)
    {
        ZoomPercent = value;
        await NotifyChanged();
    }

    private static int NormalizeZoomPercent(int value)
    {
        var clamped = Math.Clamp(value, MinZoomPercent, MaxZoomPercent);
        var snapped = (int)Math.Round((clamped - MinZoomPercent) / (double)ZoomStepPercent) * ZoomStepPercent + MinZoomPercent;

        return Math.Clamp(snapped, MinZoomPercent, MaxZoomPercent);
    }

    private async Task NotifyChanged() => await OnChanged.InvokeAsync();
}

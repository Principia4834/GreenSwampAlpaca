@using GreenSwamp.Alpaca.Settings.Models

@* Combined editor: Home Position + Park Positions *@

<MudExpansionPanels MultiExpansion="true">

    <MudExpansionPanel Text="@Loc["HomePark_Home"]" Icon="@Icons.Material.Filled.Home" Expanded="false">
        <MudStack Spacing="3">
            <MudText Typo="Typo.subtitle2">@Loc["HomePark_HomePositions"]</MudText>
            <MudSimpleTable Dense="true" Hover="true">
                <thead>
                    <tr>
                        <th>@Loc["HomePark_Position"]</th>
                        <th>@Loc["HomePark_RaAzAxis"]</th>
                        <th>@Loc["HomePark_DecAltAxis"]</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@Loc["HomePark_Home"]</td>
                        <td>@Device?.HomeAxisX.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)</td>
                        <td>@Device?.HomeAxisY.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)</td>
                    </tr>
                    <tr>
                        <td>@Loc["HomePark_AutoHome"]</td>
                        <td>@Device?.AutoHomeAxisX.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)</td>
                        <td>@Device?.AutoHomeAxisY.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)</td>
                    </tr>
                </tbody>
            </MudSimpleTable>
        </MudStack>
    </MudExpansionPanel>

    <MudExpansionPanel Text="@Loc["HomePark_Park"]" Icon="@Icons.Material.Filled.LocalParking" Expanded="false">
        <MudStack Spacing="3">
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["HomePark_ActivePark_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudTextField @bind-Value="Device!.ParkName" @bind-Value:after="NotifyChanged"
                              Label="@Loc["HomePark_ActivePark"]" Immediate="true" />
            </MudTooltip>
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["HomePark_TrackAfterUnpark_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudCheckBox @bind-Value="Device!.TrackAfterUnpark" @bind-Value:after="NotifyChanged"
                             Label="@Loc["HomePark_TrackAfterUnpark"]" Color="Color.Primary" />
            </MudTooltip>
            @if (Device?.ParkPositions is { Count: > 0 })
            {
                <MudText Typo="Typo.subtitle2" Class="mt-2">@Loc["HomePark_DefinedParkPositions"]</MudText>
                <MudSimpleTable Dense="true" Hover="true">
                    <thead>
                        <tr>
                            <th>@Loc["HomePark_Name"]</th>
                            <th>@Loc["HomePark_RaAzAxis"]</th>
                            <th>@Loc["HomePark_DecAltAxis"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Device.ParkPositions)
                        {
                            <tr>
                                <td>@p.Name</td>
                                <td>@p.X.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)</td>
                                <td>@p.Y.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </MudStack>
    </MudExpansionPanel>

</MudExpansionPanels>

@code {
    [Parameter] public SkySettings? Device { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private async Task NotifyChanged() => await OnChanged.InvokeAsync();
}

@using GreenSwamp.Alpaca.Settings.Models

@* Combined editor: Tracking + Pulse Guiding *@

<MudExpansionPanels MultiExpansion="true">

    <MudExpansionPanel Text="@Loc["Trk_Tracking"]" Icon="@Icons.Material.Filled.Speed" Expanded="false">
        <MudStack Spacing="3">
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["HomePark_TrackAfterUnpark_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudCheckBox @bind-Value="Device!.TrackAfterUnpark" @bind-Value:after="NotifyChanged"
                             Label="@Loc["HomePark_TrackAfterUnpark"]" Color="Color.Primary" />
            </MudTooltip>
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Trk_Rate_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudSelect T="string" @bind-Value="Device!.TrackingRate" @bind-Value:after="NotifyChanged"
                           Label="@Loc["Trk_Rate"]">
                    <MudSelectItem Value="@("Sidereal")">@Loc["Trk_Sidereal"]</MudSelectItem>
                    <MudSelectItem Value="@("Lunar")">@Loc["Trk_Lunar"]</MudSelectItem>
                    <MudSelectItem Value="@("Solar")">@Loc["Trk_Solar"]</MudSelectItem>
                    <MudSelectItem Value="@("King")">@Loc["Trk_King"]</MudSelectItem>
                </MudSelect>
            </MudTooltip>
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Trk_SiderealRate_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudNumericField T="double" @bind-Value="Device!.SiderealRate" @bind-Value:after="NotifyChanged"
                                 Label="@Loc["Trk_SiderealRate"]" Format="F6" Immediate="true" />
            </MudTooltip>
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Trk_LunarRate_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudNumericField T="double" @bind-Value="Device!.LunarRate" @bind-Value:after="NotifyChanged"
                                 Label="@Loc["Trk_LunarRate"]" Format="F6" Immediate="true" />
            </MudTooltip>
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Trk_SolarRate_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudNumericField T="double" @bind-Value="Device!.SolarRate" @bind-Value:after="NotifyChanged"
                                 Label="@Loc["Trk_SolarRate"]" Format="F6" Immediate="true" />
            </MudTooltip>
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Trk_KingRate_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudNumericField T="double" @bind-Value="Device!.KingRate" @bind-Value:after="NotifyChanged"
                                 Label="@Loc["Trk_KingRate"]" Format="F6" Immediate="true" />
            </MudTooltip>
            @if (ShowHidden)
            {
                <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Trk_RaOffset_Tip"]" Placement="Placement.Right" Arrow="true">
                    <MudNumericField T="int" @bind-Value="Device!.RATrackingOffset" @bind-Value:after="NotifyChanged"
                                     Label="@Loc["Trk_RaOffset"]" Immediate="true" />
                </MudTooltip>
            }
            @if (ShowHidden)
            {
                <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Trk_AltAzInterval_Tip"]" Placement="Placement.Right" Arrow="true">
                    <MudNumericField T="int" @bind-Value="Device!.AltAzTrackingUpdateInterval" @bind-Value:after="NotifyChanged"
                                     Label="@Loc["Trk_AltAzInterval"]" Immediate="true" />
                </MudTooltip>
            }
        </MudStack>
    </MudExpansionPanel>

    <MudExpansionPanel Text="@Loc["Trk_PulseGuiding"]" Icon="@Icons.Material.Filled.NearMe">
        <MudStack Spacing="3">
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Trk_MinPulseRa_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudNumericField T="int" @bind-Value="Device!.MinPulseRa" @bind-Value:after="NotifyChanged"
                                 Label="@Loc["Trk_MinPulseRa"]" Min="5" Max="50" Immediate="true" />
            </MudTooltip>
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Trk_MinPulseDec_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudNumericField T="int" @bind-Value="Device!.MinPulseDec" @bind-Value:after="NotifyChanged"
                                 Label="@Loc["Trk_MinPulseDec"]" Min="5" Max="50" Immediate="true" />
            </MudTooltip>
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Trk_DecPulseToGoTo_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudCheckBox @bind-Value="Device!.DecPulseToGoTo" @bind-Value:after="NotifyChanged"
                             Label="@Loc["Trk_DecPulseToGoTo"]" Color="Color.Primary" />
            </MudTooltip>
            <MudCheckBox @bind-Value="Device!.AlternatingPPEC" @bind-Value:after="NotifyChanged"
                         Label="@Loc["Trk_AlternatingPpec"]" Color="Color.Primary" />
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Trk_St4_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudNumericField T="int" @bind-Value="Device!.St4Guiderate" @bind-Value:after="NotifyChanged"
                                 Label="@Loc["Trk_St4"]" Min="0" Immediate="true" />
            </MudTooltip>
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Trk_RaGuideRate_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudNumericField T="int" @bind-Value="_raGuideRatePercent" @bind-Value:after="OnRaGuideRateChanged"
                                 Label="@Loc["Trk_RaGuideRate"]" Min="0" Max="100" Step="10" Immediate="true" />
            </MudTooltip>
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Trk_DecGuideRate_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudNumericField T="int" @bind-Value="_decGuideRatePercent" @bind-Value:after="OnDecGuideRateChanged"
                                 Label="@Loc["Trk_DecGuideRate"]" Min="0" Max="100" Step="10" Immediate="true" />
            </MudTooltip>
        </MudStack>
    </MudExpansionPanel>

    <MudExpansionPanel Text="@Loc["Trk_HcPulseGuides"]" Icon="@Icons.Material.Filled.Speed">
        @if (Device != null)
        {
            <HcPulseGuidesEditor Guides="@Device.HcPulseGuides"
                                 MaxRate="@Device.MaximumSlewRate"
                                 OnChanged="@NotifyChanged" />
        }
    </MudExpansionPanel>

</MudExpansionPanels>

@code {
    [Parameter] public SkySettings? Device { get; set; }
    [Parameter] public bool ShowHidden { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool _initialized;
    private bool _parametersChanging;
    private int _raGuideRatePercent;
    private int _decGuideRatePercent;

    protected override void OnParametersSet()
    {
        _parametersChanging = true;
        _raGuideRatePercent = (int)Math.Round((Device?.GuideRateOffsetX ?? 0.0) * 100);
        _decGuideRatePercent = (int)Math.Round((Device?.GuideRateOffsetY ?? 0.0) * 100);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) _initialized = true;
        _parametersChanging = false;
    }

    // Guard against MudNumericField firing ValueChanged during initial render or
    // parameter-change re-render (Min/Max coercion causing a false IsDirty on reset).
    private async Task NotifyChanged()
    {
        if (!_initialized || _parametersChanging) return;
        await OnChanged.InvokeAsync();
    }

    private async Task OnRaGuideRateChanged()
    {
        Device!.GuideRateOffsetX = _raGuideRatePercent / 100.0;
        await NotifyChanged();
    }

    private async Task OnDecGuideRateChanged()
    {
        Device!.GuideRateOffsetY = _decGuideRatePercent / 100.0;
        await NotifyChanged();
    }
}
@using GreenSwamp.Alpaca.Settings.Models

<MudStack Spacing="3">
    <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Optics_Aperture_Tip"]" Placement="Placement.Right" Arrow="true">
        <MudNumericField T="double" @bind-Value="Device!.ApertureDiameter" @bind-Value:after="NotifyChanged"
                         Label="@Loc["Optics_Aperture"]" Format="F4" Min="0" Immediate="true" />
    </MudTooltip>
    <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Optics_Area_Tip"]" Placement="Placement.Right" Arrow="true">
        <MudNumericField T="double" @bind-Value="Device!.ApertureArea" @bind-Value:after="NotifyChanged"
                         Label="@Loc["Optics_Area"]" Format="F6" Min="0" Immediate="true" />
    </MudTooltip>
    <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Optics_FocalLength_Tip"]" Placement="Placement.Right" Arrow="true">
        <MudNumericField T="double" @bind-Value="Device!.FocalLength" @bind-Value:after="NotifyChanged"
                         Label="@Loc["Optics_FocalLength"]" Format="F4" Min="0" Immediate="true" />
    </MudTooltip>
    <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Optics_Eyepiece_Tip"]" Placement="Placement.Right" Arrow="true">
        <MudNumericField T="double" @bind-Value="Device!.EyepieceFS" @bind-Value:after="NotifyChanged"
                         Label="@Loc["Optics_Eyepiece"]" Format="F2" Min="0" Immediate="true" />
    </MudTooltip>
</MudStack>

@code {
    [Parameter] public SkySettings? Device { get; set; }
    [Parameter] public bool ShowHidden { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private async Task NotifyChanged() => await OnChanged.InvokeAsync();
}

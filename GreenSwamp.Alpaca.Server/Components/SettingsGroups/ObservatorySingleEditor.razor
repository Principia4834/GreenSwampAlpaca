@using GreenSwamp.Alpaca.Settings.Models
@using GreenSwamp.Alpaca.Shared
@using GreenSwamp.Alpaca.Server.Components.Dialogs
@using GreenSwamp.Alpaca.Server.Services
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudGrid Spacing="3">

    <MudItem xs="12" sm="6">
        <MudStack Spacing="3">
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["ObsSingle_Name_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudTextField @bind-Value="Observatory!.Name"
                              @bind-Value:after="NotifyChanged"
                              Label="@Loc["ObsCard_Name"]" Immediate="true"
                              Error="@_nameError"
                              ErrorText="@_nameErrorText" />
            </MudTooltip>

            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["ObsSingle_Lat_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudNumericField T="double" @bind-Value="Observatory!.Latitude"
                                 @bind-Value:after="NotifyChanged"
                                 Label="@Loc["ObsCard_Latitude"]" Format="F6" Min="-90" Max="90" Immediate="true" />
            </MudTooltip>

            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["ObsSingle_Lon_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudNumericField T="double" @bind-Value="Observatory!.Longitude"
                                 @bind-Value:after="NotifyChanged"
                                 Label="@Loc["ObsCard_Longitude"]" Format="F6" Min="-180" Max="180" Immediate="true" />
            </MudTooltip>

            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Obs_Elev_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudNumericField T="double" @bind-Value="Observatory!.Elevation"
                                 @bind-Value:after="NotifyChanged"
                                 Label="@Loc["ObsCard_Elevation"]" Format="F1" Min="-500" Max="9000" Immediate="true" />
            </MudTooltip>

            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["ObsSingle_Utc_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudNumericField T="double" @bind-Value="_utcOffsetHours"
                                 @bind-Value:after="OnUtcOffsetChanged"
                                 Label="@Loc["ObsCard_UtcOffset"]" Format="F1" Min="-14" Max="14" Immediate="true" />
            </MudTooltip>
        </MudStack>
    </MudItem>

    <MudItem xs="12" sm="6">
        <MudStack Spacing="3">
            <MudText Typo="Typo.body1">@Loc["ObsSingle_LocationSources"]</MudText>

            <MudExpansionPanel Text="GPS" Icon="@Icons.Material.Filled.GpsFixed">

                 <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["ObsSingle_GpsPort_Tip"]" Placement="Placement.Right" Arrow="true">
                @if (_availableGpsPorts.Length > 0)
                {
                    <MudSelect @bind-Value="Observatory!.GpsPort" @bind-Value:after="NotifyChanged"
                               Label="@Loc["Obs_GpsPort"]" AnchorOrigin="Origin.BottomLeft">
                        @foreach (var port in _availableGpsPorts)
                        {
                            <MudSelectItem Value="@port">@port</MudSelectItem>
                        }
                        @if (!string.IsNullOrWhiteSpace(Observatory!.GpsPort) && !_availableGpsPorts.Contains(Observatory!.GpsPort, StringComparer.OrdinalIgnoreCase))
                        {
                            <MudSelectItem Value="@Observatory!.GpsPort">@Loc["MC_PortManual", Observatory!.GpsPort]</MudSelectItem>
                        }
                    </MudSelect>
                }
                else
                {
                    <MudTextField @bind-Value="Observatory!.GpsPort" @bind-Value:after="NotifyChanged"
                                  Label="@Loc["Obs_GpsPort"]" Immediate="true"
                                  HelperText="@Loc["MC_PortHelper"]" />
                }
            </MudTooltip>

            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["ObsSingle_GpsBaud_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudSelect T="int" @bind-Value="Observatory!.GpsBaudRate" @bind-Value:after="NotifyChanged"
                           Label="@Loc["Obs_GpsBaud"]">
                    <MudSelectItem Value="4800">4800</MudSelectItem>
                    <MudSelectItem Value="9600">9600</MudSelectItem>
                    <MudSelectItem Value="19200">19200</MudSelectItem>
                    <MudSelectItem Value="38400">38400</MudSelectItem>
                    <MudSelectItem Value="57600">57600</MudSelectItem>
                    <MudSelectItem Value="115200">115200</MudSelectItem>
                </MudSelect>
            </MudTooltip>

            @* Advanced GPS serial settings (Parity, Stop Bits, Data Bits, Timeout, Handshake) are
               intentionally hidden from this panel but remain bound in ObservatoryInfo and are
               still used by NmeaGpsReader when a fix is requested. *@
            @if (ShowHidden)
            {
                <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Obs_GpsParity_Tip"]" Placement="Placement.Right" Arrow="true">
                    <MudSelect T="string" @bind-Value="Observatory!.GpsParity" @bind-Value:after="NotifyChanged"
                               Label="@Loc["Obs_GpsParity"]">
                        <MudSelectItem Value="@("None")">None</MudSelectItem>
                        <MudSelectItem Value="@("Odd")">Odd</MudSelectItem>
                        <MudSelectItem Value="@("Even")">Even</MudSelectItem>
                        <MudSelectItem Value="@("Mark")">Mark</MudSelectItem>
                        <MudSelectItem Value="@("Space")">Space</MudSelectItem>
                    </MudSelect>
                </MudTooltip>
                <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Obs_GpsStopBits_Tip"]" Placement="Placement.Right" Arrow="true">
                    <MudSelect T="string" @bind-Value="Observatory!.GpsStopBits" @bind-Value:after="NotifyChanged"
                               Label="@Loc["Obs_GpsStopBits"]">
                        <MudSelectItem Value="@("None")">None</MudSelectItem>
                        <MudSelectItem Value="@("One")">One</MudSelectItem>
                        <MudSelectItem Value="@("OnePointFive")">OnePointFive</MudSelectItem>
                        <MudSelectItem Value="@("Two")">Two</MudSelectItem>
                    </MudSelect>
                </MudTooltip>
                <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Obs_GpsDataBits_Tip"]" Placement="Placement.Right" Arrow="true">
                    <MudSelect T="int" @bind-Value="Observatory!.GpsDataBits" @bind-Value:after="NotifyChanged"
                               Label="@Loc["Obs_GpsDataBits"]">
                        <MudSelectItem Value="5">5</MudSelectItem>
                        <MudSelectItem Value="6">6</MudSelectItem>
                        <MudSelectItem Value="7">7</MudSelectItem>
                        <MudSelectItem Value="8">8</MudSelectItem>
                    </MudSelect>
                </MudTooltip>
                <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Obs_GpsTimeout_Tip"]" Placement="Placement.Right" Arrow="true">
                    <MudNumericField T="int" @bind-Value="Observatory!.GpsTimeout" @bind-Value:after="NotifyChanged"
                                     Label="@Loc["Obs_GpsTimeout"]" Min="1" Max="30" />
                </MudTooltip>
                <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Obs_GpsHandshake_Tip"]" Placement="Placement.Right" Arrow="true">
                    <MudSelect T="string" @bind-Value="Observatory!.GpsHandshake" @bind-Value:after="NotifyChanged"
                               Label="@Loc["Obs_GpsHandshake"]">
                        <MudSelectItem Value="@("None")">None</MudSelectItem>
                        <MudSelectItem Value="@("XOnXOff")">XOnXOff</MudSelectItem>
                        <MudSelectItem Value="@("RequestToSend")">RequestToSend</MudSelectItem>
                        <MudSelectItem Value="@("RequestToSendXOnXOff")">RequestToSendXOnXOff</MudSelectItem>
                    </MudSelect>
                </MudTooltip>
            }

            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Obs_GpsConnect_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.GpsFixed"
                           OnClick="OpenGpsFixAsync">
                    @Loc["Obs_Connect"]
                </MudButton>
            </MudTooltip>
            </MudExpansionPanel>

            <MudExpansionPanel Text="Cartes du Ciel" Icon="@Icons.Material.Filled.Language">
                <MudStack Spacing="3">
                    <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["ObsSingle_CdcAddress_Tip"]" Placement="Placement.Right" Arrow="true">
                        <MudTextField @bind-Value="Observatory!.CdcAddress"
                                      @bind-Value:after="NotifyChanged"
                                      Label="@Loc["Obs_CdcAddress"]" Immediate="true" />
                    </MudTooltip>
                    <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Obs_CdcPort_Tip"]" Placement="Placement.Right" Arrow="true">
                        <MudNumericField T="int" @bind-Value="Observatory!.CdcPort"
                                         @bind-Value:after="NotifyChanged"
                                         Label="@Loc["Obs_CdcPort"]" Min="1" Max="65535" Immediate="true" />
                    </MudTooltip>
                    <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Obs_CdcConnect_Tip"]" Placement="Placement.Right" Arrow="true">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Language"
                                   OnClick="OpenCdcDialogAsync">
                            @Loc["Obs_Connect"]
                        </MudButton>
                    </MudTooltip>
                </MudStack>
            </MudExpansionPanel>

            @if (DeviceSettings is { Count: > 0 })
            {
                <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["ObsSingle_CopyToAll_Tip"]" Placement="Placement.Right" Arrow="true">
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.CopyAll"
                               OnClick="CopyToAllDevices">
                        @Loc["ObsSingle_CopyToAll"]
                    </MudButton>
                </MudTooltip>
            }
        </MudStack>
    </MudItem>

</MudGrid>

@code {
    /// <summary>The individual observatory being edited (working copy).</summary>
    [Parameter] public ObservatoryInfo? Observatory { get; set; }

    /// <summary>All observatories in the working copy — used for name-uniqueness validation.</summary>
    [Parameter] public ObservatorySettings? AllObservatories { get; set; }
    [Parameter] public bool ShowHidden { get; set; }

    [Parameter] public Dictionary<int, SkySettings>? DeviceSettings { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback<ObservatoryInfo> OnCopyToAllDevices { get; set; }

    private double _utcOffsetHours;
    private bool _nameError;
    private string _nameErrorText = string.Empty;
    private string[] _availableGpsPorts = [];

    protected override void OnInitialized()
    {
        _availableGpsPorts = SerialPortDiscovery.GetPortNames();
    }

    protected override void OnParametersSet()
    {
        if (Observatory is not null)
            _utcOffsetHours = Observatory.UTCOffset.TotalHours;
    }

    private async Task OnUtcOffsetChanged()
    {
        if (Observatory is not null)
            Observatory.UTCOffset = TimeSpan.FromHours(_utcOffsetHours);
        await NotifyChanged();
    }

    private async Task NotifyChanged()
    {
        ValidateName();
        await OnChanged.InvokeAsync();
    }

    private void ValidateName()
    {
        if (Observatory is null) return;
        if (string.IsNullOrWhiteSpace(Observatory.Name))
        {
            _nameError = true;
            _nameErrorText = Loc["ObsSingle_NameRequired"].Value;
            return;
        }
        var isDuplicate = AllObservatories?.Observatories
            .Any(o => o.Id != Observatory.Id
                      && string.Equals(o.Name, Observatory.Name, StringComparison.OrdinalIgnoreCase))
            ?? false;
        _nameError = isDuplicate;
        _nameErrorText = isDuplicate ? Loc["ObsSingle_NameDuplicate"].Value : string.Empty;
    }

    private async Task CopyToAllDevices()
    {
        if (Observatory is null) return;
        await OnCopyToAllDevices.InvokeAsync(Observatory);
        await OnChanged.InvokeAsync();
    }

    private async Task OpenGpsFixAsync()
    {
        if (Observatory is null) return;
        if (string.IsNullOrWhiteSpace(Observatory.GpsPort))
        {
            Snackbar.Add(Loc["Obs_NoGpsPortSite"], Severity.Warning);
            return;
        }

        var connectionParams = new GpsConnectionParams(
            Observatory.GpsPort,
            Observatory.GpsBaudRate,
            Observatory.GpsParity,
            Observatory.GpsStopBits,
            Observatory.GpsDataBits,
            Observatory.GpsTimeout,
            Observatory.GpsHandshake);

        var parameters = new DialogParameters<GpsFixDialog>
        {
            { d => d.ConnectionParams, connectionParams }
        };

        var dialog = await DialogService.ShowAsync<GpsFixDialog>(
            Loc["Gps_Title"], parameters,
            new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, BackdropClick = false});

        var result = await dialog.Result;
        if (result.Canceled || result.Data is not GpsFixResult fix) return;

        Observatory.Latitude = fix.Latitude;
        Observatory.Longitude = fix.Longitude;
        Observatory.Elevation = fix.Altitude;
        Snackbar.Add(Loc["Obs_UpdatedFromGps"], Severity.Success);
        await NotifyChanged();
    }

    private async Task OpenCdcDialogAsync()
    {
        if (Observatory is null) return;

        var connectionParams = new CdcConnectionParams(Observatory.CdcAddress, Observatory.CdcPort);

        var parameters = new DialogParameters<CdcDialog>
        {
            { d => d.ConnectionParams, connectionParams },
            { d => d.LocalLatitude,    Observatory.Latitude },
            { d => d.LocalLongitude,   Observatory.Longitude },
            { d => d.LocalAltitude,    Observatory.Elevation }
        };

        var dialog = await DialogService.ShowAsync<CdcDialog>(
            "Cartes du Ciel", parameters,
            new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, BackdropClick = false });

        var result = await dialog.Result;
        if (result.Canceled || result.Data is not CdcLocationResult location) return;

        Observatory.Latitude  = location.Latitude;
        Observatory.Longitude = location.Longitude;
        Observatory.Elevation = location.Altitude;
        Snackbar.Add(Loc["Obs_UpdatedFromCdc"], Severity.Success);
        await NotifyChanged();
    }
}
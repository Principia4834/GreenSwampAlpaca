@using GreenSwamp.Alpaca.Settings.Models
@using GreenSwamp.Alpaca.Shared
@using GreenSwamp.Alpaca.Server.Components.Dialogs
@using GreenSwamp.Alpaca.Server.Services
@inject MudBlazor.ISnackbar Snackbar
@inject MudBlazor.IDialogService DialogService

@* Combined editor: Location + Environmental + GPS *@

<MudExpansionPanels MultiExpansion="true" Elevation="0">

    <MudExpansionPanel Text="@Loc["Obs_Location"]" Icon="@Icons.Material.Filled.MyLocation" Expanded="false">
        <MudStack Spacing="3">
            @if (Observatory?.Observatories is { Count: > 0 })
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudSelect T="string" @bind-Value="_selectedObservatoryId"
                               Label="@Loc["Obs_CopyFrom"]" Dense="true"
                               Style="max-width:15rem"
                               AnchorOrigin="Origin.BottomLeft">
                        @foreach (var obs in Observatory.Observatories)
                        {
                            <MudSelectItem Value="@obs.Id">@obs.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Obs_CopyFrom_Tip"]" Placement="Placement.Right" Arrow="true">
                        <MudIconButton Icon="@Icons.Material.Filled.CopyAll"
                                       Color="Color.Secondary" Size="Size.Small"
                                       Disabled="@string.IsNullOrEmpty(_selectedObservatoryId)"
                                       OnClick="CopyFromSelectedObservatory" />
                    </MudTooltip>
                </MudStack>
            }
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Obs_DeviceLat_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudNumericField T="double" @bind-Value="Device!.Latitude" @bind-Value:after="NotifyChanged"
                                 Label="@Loc["ObsCard_Latitude"]" Format="F6" Min="-90" Max="90" Immediate="true" />
            </MudTooltip>
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Obs_DeviceLon_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudNumericField T="double" @bind-Value="Device!.Longitude" @bind-Value:after="NotifyChanged"
                                 Label="@Loc["ObsCard_Longitude"]" Format="F6" Min="-180" Max="180" Immediate="true" />
            </MudTooltip>
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Obs_Elev_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudNumericField T="double" @bind-Value="Device!.Elevation" @bind-Value:after="NotifyChanged"
                                 Label="@Loc["ObsCard_Elevation"]" Format="F1" Min="-500" Max="9000" Immediate="true" />
            </MudTooltip>
            @if (ShowHidden)
            {
                <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Obs_DeviceUtc_Tip"]" Placement="Placement.Right" Arrow="true">
                    <MudNumericField T="double" @bind-Value="_utcHours" @bind-Value:after="OnUtcChanged"
                                     Label="@Loc["ObsCard_UtcOffset"]" Format="F2" Min="-14" Max="14" Immediate="true" />
                </MudTooltip>
            }
        </MudStack>
    </MudExpansionPanel>

    <MudExpansionPanel Text="@Loc["Obs_Environmental"]" Icon="@Icons.Material.Filled.Air">
        <MudStack Spacing="3">
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Obs_Refraction_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudCheckBox @bind-Value="Device!.Refraction" @bind-Value:after="NotifyChanged"
                             Label="@Loc["Obs_Refraction"]" Color="Color.Primary" />
            </MudTooltip>
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Obs_Temp_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudNumericField T="double" @bind-Value="Device!.Temperature" @bind-Value:after="NotifyChanged"
                                 Label="@Loc["Obs_Temp"]" Format="F1" Min="-50" Max="60" Immediate="true" />
            </MudTooltip>
        </MudStack>
    </MudExpansionPanel>

    <MudExpansionPanel Text="GPS" Icon="@Icons.Material.Filled.GpsFixed">
        <MudStack Spacing="3">
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Obs_DeviceGpsPort_Tip"]" Placement="Placement.Right" Arrow="true">
                @if (_availableGpsPorts.Length > 0)
                {
                    <MudSelect @bind-Value="Device!.GpsPort" @bind-Value:after="NotifyChanged"
                               Label="@Loc["Obs_GpsPort"]" AnchorOrigin="Origin.BottomLeft">
                        @foreach (var port in _availableGpsPorts)
                        {
                            <MudSelectItem Value="@port">@port</MudSelectItem>
                        }
                        @if (!string.IsNullOrWhiteSpace(Device!.GpsPort) && !_availableGpsPorts.Contains(Device!.GpsPort, StringComparer.OrdinalIgnoreCase))
                        {
                            <MudSelectItem Value="@Device!.GpsPort">@Loc["MC_PortManual", Device!.GpsPort]</MudSelectItem>
                        }
                    </MudSelect>
                }
                else
                {
                    <MudTextField @bind-Value="Device!.GpsPort" @bind-Value:after="NotifyChanged"
                                  Label="@Loc["Obs_GpsPort"]" Immediate="true"
                                  HelperText="@Loc["MC_PortHelper"]" />
                }
            </MudTooltip>
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Obs_DeviceGpsBaud_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudSelect T="int" @bind-Value="Device!.GpsBaudRate" @bind-Value:after="NotifyChanged"
                           Label="@Loc["Obs_GpsBaud"]">
                    <MudSelectItem Value="4800">4800</MudSelectItem>
                    <MudSelectItem Value="9600">9600</MudSelectItem>
                    <MudSelectItem Value="19200">19200</MudSelectItem>
                    <MudSelectItem Value="38400">38400</MudSelectItem>
                    <MudSelectItem Value="57600">57600</MudSelectItem>
                    <MudSelectItem Value="115200">115200</MudSelectItem>
                </MudSelect>
            </MudTooltip>
            @* Advanced GPS serial settings (Parity, Stop Bits, Data Bits, Timeout, Handshake) are
               intentionally hidden from this panel but remain bound in SkySettings and are
               still used by NmeaGpsReader when a fix is requested. *@
            @if (ShowHidden)
            {
                <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Obs_GpsParity_Tip"]" Placement="Placement.Right" Arrow="true">
                    <MudSelect T="string" @bind-Value="Device!.GpsParity" @bind-Value:after="NotifyChanged"
                               Label="@Loc["Obs_GpsParity"]">
                        <MudSelectItem Value="@("None")">None</MudSelectItem>
                        <MudSelectItem Value="@("Odd")">Odd</MudSelectItem>
                        <MudSelectItem Value="@("Even")">Even</MudSelectItem>
                        <MudSelectItem Value="@("Mark")">Mark</MudSelectItem>
                        <MudSelectItem Value="@("Space")">Space</MudSelectItem>
                    </MudSelect>
                </MudTooltip>
                <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Obs_GpsStopBits_Tip"]" Placement="Placement.Right" Arrow="true">
                    <MudSelect T="string" @bind-Value="Device!.GpsStopBits" @bind-Value:after="NotifyChanged"
                               Label="@Loc["Obs_GpsStopBits"]">
                        <MudSelectItem Value="@("None")">None</MudSelectItem>
                        <MudSelectItem Value="@("One")">One</MudSelectItem>
                        <MudSelectItem Value="@("OnePointFive")">OnePointFive</MudSelectItem>
                        <MudSelectItem Value="@("Two")">Two</MudSelectItem>
                    </MudSelect>
                </MudTooltip>
                <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Obs_GpsDataBits_Tip"]" Placement="Placement.Right" Arrow="true">
                    <MudSelect T="int" @bind-Value="Device!.GpsDataBits" @bind-Value:after="NotifyChanged"
                               Label="@Loc["Obs_GpsDataBits"]">
                        <MudSelectItem Value="5">5</MudSelectItem>
                        <MudSelectItem Value="6">6</MudSelectItem>
                        <MudSelectItem Value="7">7</MudSelectItem>
                        <MudSelectItem Value="8">8</MudSelectItem>
                    </MudSelect>
                </MudTooltip>
                <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Obs_GpsTimeout_Tip"]" Placement="Placement.Right" Arrow="true">
                    <MudNumericField T="int" @bind-Value="Device!.GpsTimeout" @bind-Value:after="NotifyChanged"
                                     Label="@Loc["Obs_GpsTimeout"]" Min="1" Max="30" />
                </MudTooltip>
                <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Obs_GpsHandshake_Tip"]" Placement="Placement.Right" Arrow="true">
                    <MudSelect T="string" @bind-Value="Device!.GpsHandshake" @bind-Value:after="NotifyChanged"
                               Label="@Loc["Obs_GpsHandshake"]">
                        <MudSelectItem Value="@("None")">None</MudSelectItem>
                        <MudSelectItem Value="@("XOnXOff")">XOnXOff</MudSelectItem>
                        <MudSelectItem Value="@("RequestToSend")">RequestToSend</MudSelectItem>
                        <MudSelectItem Value="@("RequestToSendXOnXOff")">RequestToSendXOnXOff</MudSelectItem>
                    </MudSelect>
                </MudTooltip>
            }
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Obs_GpsConnect_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.GpsFixed"
                           OnClick="OpenGpsFixAsync">
                    @Loc["Obs_Connect"]
                </MudButton>
            </MudTooltip>
        </MudStack>
    </MudExpansionPanel>

    <MudExpansionPanel Text="Cartes du Ciel" Icon="@Icons.Material.Filled.Language">
        <MudStack Spacing="3">
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Obs_DeviceCdcAddress_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudTextField @bind-Value="Device!.CdcAddress"
                              @bind-Value:after="NotifyChanged"
                              Label="@Loc["Obs_CdcAddress"]" Immediate="true" />
            </MudTooltip>
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Obs_CdcPort_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudNumericField T="int" @bind-Value="Device!.CdcPort"
                                 @bind-Value:after="NotifyChanged"
                                 Label="@Loc["Obs_CdcPort"]" Min="1" Max="65535" Immediate="true" />
            </MudTooltip>
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Obs_CdcConnect_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Language"
                           OnClick="OpenCdcDialogAsync">
                    @Loc["Obs_Connect"]
                </MudButton>
            </MudTooltip>
        </MudStack>
    </MudExpansionPanel>

</MudExpansionPanels>

@code {
    [Parameter] public SkySettings? Device { get; set; }
    [Parameter] public bool ShowHidden { get; set; }
    [Parameter] public ObservatorySettings? Observatory { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private string _selectedObservatoryId = string.Empty;
    private string[] _availableGpsPorts = [];

    protected override void OnInitialized()
    {
        _availableGpsPorts = SerialPortDiscovery.GetPortNames();
    }

    protected override void OnParametersSet()
    {
        if (Device is not null)
            _utcHours = Device.UTCOffset.TotalHours;
        // Pre-select the first observatory if none selected yet
        if (string.IsNullOrEmpty(_selectedObservatoryId) && Observatory?.Observatories is { Count: > 0 })
            _selectedObservatoryId = Observatory.Observatories[0].Id;
    }

    private async Task CopyFromSelectedObservatory()
    {
        if (Device is null || Observatory is null) return;
        var source = Observatory.Observatories.FirstOrDefault(o => o.Id == _selectedObservatoryId);
        if (source is null) return;
        Device.Latitude     = source.Latitude;
        Device.Longitude    = source.Longitude;
        Device.Elevation    = source.Elevation;
        Device.GpsPort      = source.GpsPort;
        Device.GpsBaudRate  = source.GpsBaudRate;
        Device.GpsParity    = source.GpsParity;
        Device.GpsStopBits  = source.GpsStopBits;
        Device.GpsDataBits  = source.GpsDataBits;
        Device.GpsTimeout   = source.GpsTimeout;
        Device.GpsHandshake = source.GpsHandshake;
        Device.CdcAddress   = source.CdcAddress;
        Device.CdcPort      = source.CdcPort;
        Snackbar.Add(Loc["Obs_CopiedFrom", source.Name], MudBlazor.Severity.Success);
        await NotifyChanged();
    }

    private double _utcHours;

    private async Task OnUtcChanged()
    {
        if (Device is not null)
            Device.UTCOffset = TimeSpan.FromHours(_utcHours);
        await NotifyChanged();
    }

    private async Task OpenGpsFixAsync()
    {
        if (Device is null) return;
        if (string.IsNullOrWhiteSpace(Device.GpsPort))
        {
            Snackbar.Add(Loc["Obs_NoGpsPortDevice"], MudBlazor.Severity.Warning);
            return;
        }

        var connectionParams = new GpsConnectionParams(
            Device.GpsPort,
            Device.GpsBaudRate,
            Device.GpsParity,
            Device.GpsStopBits,
            Device.GpsDataBits,
            Device.GpsTimeout,
            Device.GpsHandshake);

        var parameters = new DialogParameters<GpsFixDialog>
        {
            { d => d.ConnectionParams, connectionParams }
        };

        var dialog = await DialogService.ShowAsync<GpsFixDialog>(
            Loc["Gps_Title"], parameters,
            new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true });

        var result = await dialog.Result;
        if (result.Canceled || result.Data is not GpsFixResult fix) return;

        Device.Latitude = fix.Latitude;
        Device.Longitude = fix.Longitude;
        Device.Elevation = fix.Altitude;
        Snackbar.Add(Loc["Obs_UpdatedFromGps"], MudBlazor.Severity.Success);
        await NotifyChanged();
    }

    private async Task OpenCdcDialogAsync()
    {
        if (Device is null) return;

        var connectionParams = new CdcConnectionParams(Device.CdcAddress, Device.CdcPort);

        var parameters = new DialogParameters<CdcDialog>
        {
            { d => d.ConnectionParams, connectionParams },
            { d => d.LocalLatitude,    Device.Latitude },
            { d => d.LocalLongitude,   Device.Longitude },
            { d => d.LocalAltitude,    Device.Elevation }
        };

        var dialog = await DialogService.ShowAsync<CdcDialog>(
            "Cartes du Ciel", parameters,
            new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, BackdropClick = false });

        var result = await dialog.Result;
        if (result.Canceled || result.Data is not CdcLocationResult location) return;

        Device.Latitude  = location.Latitude;
        Device.Longitude = location.Longitude;
        Device.Elevation = location.Altitude;
        Snackbar.Add(Loc["Obs_UpdatedFromCdc"], MudBlazor.Severity.Success);
        await NotifyChanged();
    }

    private async Task NotifyChanged() => await OnChanged.InvokeAsync();
}

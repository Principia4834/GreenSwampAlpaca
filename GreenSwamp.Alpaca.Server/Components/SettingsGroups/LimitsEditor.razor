@using GreenSwamp.Alpaca.Settings.Models

@* Unified panel: hardware limit values + tracking-limit actions + sync limits *@

<MudExpansionPanels MultiExpansion="true">

    <MudExpansionPanel Text="@Loc["Lim_HardwarePanel"]" Icon="@Icons.Material.Filled.Block" Expanded="false">
        <MudStack Spacing="3">
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Lim_UpperDecAlt_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudNumericField T="double" @bind-Value="Device!.AxisUpperLimitY" @bind-Value:after="NotifyChanged"
                                 Label="@Loc["Lim_UpperDecAlt"]" Format="F2" Converter="@(NumericFieldConverter.Invariant("F2"))" Immediate="true" />
            </MudTooltip>
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Lim_LowerDecAlt_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudNumericField T="double" @bind-Value="Device!.AxisLowerLimitY" @bind-Value:after="NotifyChanged"
                                 Label="@Loc["Lim_LowerDecAlt"]" Format="F2" Converter="@(NumericFieldConverter.Invariant("F2"))" Immediate="true" />
            </MudTooltip>
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Lim_RaAz_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudNumericField T="double" @bind-Value="Device!.AxisLimitX" @bind-Value:after="NotifyChanged"
                                 Label="@Loc["Lim_RaAz"]" Format="F2" Converter="@(NumericFieldConverter.Invariant("F2"))" Immediate="true" />
            </MudTooltip>
        </MudStack>
    </MudExpansionPanel>

    <MudExpansionPanel Text="@Loc["Lim_ActionsPanel"]" Icon="@Icons.Material.Filled.WarningAmber" Expanded="false">
        <MudStack Spacing="3">
            <MudCheckBox @bind-Value="Device!.LimitsOn" @bind-Value:after="NotifyChanged"
                         Label="@Loc["Lim_LimitsOn"]" Color="Color.Primary" />

            @if (IsGem)
            {
                <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Lim_FlipAngle_Tip"]" Placement="Placement.Right" Arrow="true">
                    <MudNumericField T="double" @bind-Value="Device!.HourAngleLimit" @bind-Value:after="NotifyChanged"
                                     Label="@Loc["GoTo_FlipAngle"]" Format="F2" Converter="@(NumericFieldConverter.Invariant("F2"))" Min="0" Max="30" Immediate="true" />
                </MudTooltip>
                <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Lim_AfterFlip_Tip"]" Placement="Placement.Right" Arrow="true">
                    <MudNumericField T="double" @bind-Value="Device!.AxisTrackingLimit" @bind-Value:after="NotifyChanged"
                                     Label="@Loc["GoTo_TrackingLimitAfterFlip"]" Format="F2" Converter="@(NumericFieldConverter.Invariant("F2"))" Min="0" Max="15" Immediate="true" />
                </MudTooltip>
                <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Lim_HzTracking_Tip"]" Placement="Placement.Right" Arrow="true">
                    <MudNumericField T="double" @bind-Value="Device!.AxisHzTrackingLimit" @bind-Value:after="NotifyChanged"
                                     Label="@Loc["GoTo_HorizonTrackingLimit"]" Format="F2" Converter="@(NumericFieldConverter.Invariant("F2"))" Immediate="true" />
                </MudTooltip>
            }
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Lim_HzGoTo_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudNumericField T="double" @bind-Value="Device!.HorizonLimit" @bind-Value:after="NotifyChanged"
                                  Label="@Loc["GoTo_HorizonGoToLimit"]" Format="F2" Converter="@(NumericFieldConverter.Invariant("F2"))" Min="-20" Max="30" Immediate="true" />
            </MudTooltip>

            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@PrimaryActionHelpText" Placement="Placement.Right" Arrow="true">
                <MudSelect T="GreenSwamp.Alpaca.MountControl.LimitAction" Value="@PrimaryAction" ValueChanged="OnPrimaryActionChanged" Label="@PrimaryActionLabel">
                    <MudSelectItem Value="@GreenSwamp.Alpaca.MountControl.LimitAction.None">@Loc["Lim_WarningOnly"]</MudSelectItem>
                    <MudSelectItem Value="@GreenSwamp.Alpaca.MountControl.LimitAction.StopTracking">@Loc["Lim_StopTracking"]</MudSelectItem>
                    <MudSelectItem Value="@GreenSwamp.Alpaca.MountControl.LimitAction.Park">@Loc["GoTo_ParkAction"]</MudSelectItem>
                </MudSelect>
            </MudTooltip>

            <MudSelect T="string"
                        Value="@Device!.ParkLimitName"
                        ValueChanged="OnPrimaryParkPositionChanged"
                        Label="@Loc["Lim_PrimaryPark"]"
                        Disabled="@(PrimaryAction != GreenSwamp.Alpaca.MountControl.LimitAction.Park)">
                @foreach (var name in ParkPositionNames)
                {
                    <MudSelectItem Value="@name">@name</MudSelectItem>
                }
            </MudSelect>

            @if (IsGem)
            {
                <MudDivider />
                <MudText Typo="Typo.subtitle2">@Loc["Lim_GemHorizonAction"]</MudText>

                <MudSelect T="GreenSwamp.Alpaca.MountControl.LimitAction" Value="@HorizonAction" ValueChanged="OnHorizonActionChanged" Label="@Loc["Lim_HorizonTrigger"]">
                    <MudSelectItem Value="@GreenSwamp.Alpaca.MountControl.LimitAction.None">@Loc["Lim_WarningOnly"]</MudSelectItem>
                    <MudSelectItem Value="@GreenSwamp.Alpaca.MountControl.LimitAction.StopTracking">@Loc["Lim_StopTracking"]</MudSelectItem>
                    <MudSelectItem Value="@GreenSwamp.Alpaca.MountControl.LimitAction.Park">@Loc["GoTo_ParkAction"]</MudSelectItem>
                </MudSelect>

                <MudSelect T="string"
                            Value="@Device!.ParkHzLimitName"
                            ValueChanged="OnHorizonParkPositionChanged"
                            Label="@Loc["Lim_HorizonPark"]"
                            Disabled="@(HorizonAction != GreenSwamp.Alpaca.MountControl.LimitAction.Park)">
                    @foreach (var name in ParkPositionNames)
                    {
                        <MudSelectItem Value="@name">@name</MudSelectItem>
                    }
                </MudSelect>
            }
        </MudStack>
    </MudExpansionPanel>

    <MudExpansionPanel Text="@Loc["Lim_SyncPanel"]" Icon="@Icons.Material.Filled.SyncAlt" Expanded="false">
        <MudStack Spacing="3">
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Lim_EnableSyncLimit_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudCheckBox @bind-Value="Device!.SyncLimitOn" @bind-Value:after="NotifyChanged"
                             Label="@Loc["Lim_EnableSyncLimit"]" Color="Color.Primary" />
            </MudTooltip>
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Lim_SyncAngle_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudNumericField T="int" @bind-Value="Device!.SyncLimit" @bind-Value:after="NotifyChanged"
                                 Label="@Loc["Lim_SyncAngle"]" Min="0" Max="60" Immediate="true"
                                 Disabled="@(!Device!.SyncLimitOn)" />
            </MudTooltip>
            <MudTooltip Inline="false" RootStyle="max-width:260px" Text="@Loc["Lim_NoSyncMeridian_Tip"]" Placement="Placement.Right" Arrow="true">
                <MudCheckBox @bind-Value="Device!.NoSyncPastMeridian" @bind-Value:after="NotifyChanged"
                             Label="@Loc["Lim_NoSyncMeridian"]" Color="Color.Primary" />
            </MudTooltip>
        </MudStack>
    </MudExpansionPanel>

</MudExpansionPanels>

@code {
    [Parameter] public SkySettings? Device { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool IsGem => Device?.AlignmentMode?.Equals("GermanPolar", StringComparison.OrdinalIgnoreCase) ?? false;

    private string PrimaryActionLabel => IsGem
        ? Loc["Lim_PrimaryLabelGem"].Value
        : Loc["Lim_PrimaryLabelHw"].Value;

    private string PrimaryActionHelpText => IsGem
        ? Loc["Lim_PrimaryHelpGem"].Value
        : Loc["Lim_PrimaryHelpHw"].Value;

    private IReadOnlyList<string> ParkPositionNames =>
        Device?.ParkPositions?.Select(p => p.Name).Where(n => !string.IsNullOrWhiteSpace(n)).Distinct().OrderBy(n => n).ToList()
        ?? [];

    private GreenSwamp.Alpaca.MountControl.LimitAction PrimaryAction =>
        ParseLimitAction(Device?.MeridianTrackingAction);

    private GreenSwamp.Alpaca.MountControl.LimitAction HorizonAction =>
        ParseLimitAction(Device?.HorizonTrackingAction);

    private static GreenSwamp.Alpaca.MountControl.LimitAction ParseLimitAction(string? value)
        => Enum.TryParse<GreenSwamp.Alpaca.MountControl.LimitAction>(value, true, out var action)
            ? action
            : GreenSwamp.Alpaca.MountControl.LimitAction.None;

    private bool _initialized;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) _initialized = true;
    }

    private async Task OnPrimaryActionChanged(GreenSwamp.Alpaca.MountControl.LimitAction value)
    {
        if (Device is null) return;
        Device.MeridianTrackingAction = value.ToString();
        await NotifyChanged();
    }

    private async Task OnHorizonActionChanged(GreenSwamp.Alpaca.MountControl.LimitAction value)
    {
        if (Device is null) return;
        Device.HorizonTrackingAction = value.ToString();
        await NotifyChanged();
    }

    private async Task OnPrimaryParkPositionChanged(string value)
    {
        if (Device is null) return;
        Device.ParkLimitName = value ?? string.Empty;
        await NotifyChanged();
    }

    private async Task OnHorizonParkPositionChanged(string value)
    {
        if (Device is null) return;
        Device.ParkHzLimitName = value ?? string.Empty;
        await NotifyChanged();
    }

    private async Task NotifyChanged()
    {
        if (!_initialized) return;
        await OnChanged.InvokeAsync();
    }
}

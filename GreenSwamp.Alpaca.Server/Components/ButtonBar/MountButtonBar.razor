@using ASCOM.Alpaca
@using GreenSwamp.Alpaca.MountControl
@using GreenSwamp.Alpaca.Server.Components
@using GreenSwamp.Alpaca.Server.Components.ButtonBar
@using GreenSwamp.Alpaca.Server.Components.Dialogs
@using GreenSwamp.Alpaca.Server.Models
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@if (ShowPrimaryButtons)
{
    @* Fixed 4×2 grid: columns size to icon content *@
    <div style="display:inline-grid; grid-template-columns: repeat(4, auto);">

        @* -- Park --------------------------------------------------------------- *@
        <MudTooltip Text="@(State.AtPark ? Loc["MountButtons_UnparkTooltip"] : Loc["MountButtons_ParkTooltip"])"
                    Placement="Placement.Top" Arrow="true">
            <MudIconButton Icon="@Icons.Material.Filled.LocalParking"
                           Color="@(State.AtPark ? Color.Warning : Color.Primary)"
                           Variant="Variant.Outlined"
                           Size="Size.Large"
                           Class="ma-2 gs-icon-button-rounded"
                           Disabled="@(!IsConnected || (State.AtPark
                                                                     ? !(Mount?.Settings.CanUnPark ?? false)
                                                                     : !(Mount?.Settings.CanPark ?? false)))"
                           OnClick="OnParkClickAsync" />
        </MudTooltip>

        @* -- Home --------------------------------------------------------------- *@
        <MudTooltip Text="@Loc["MountButtons_HomeTooltip"]" Placement="Placement.Top" Arrow="true">
            <MudIconButton Icon="@Icons.Material.Filled.Home"
                           Color="Color.Primary"
                           Variant="Variant.Outlined"
                           Size="Size.Large"
                           Class="ma-2 gs-icon-button-rounded"
                           Disabled="@(!IsConnected || State.AtPark || !(Mount?.Settings.CanFindHome ?? false))"
                           OnClick="OnHomeClickAsync" />
        </MudTooltip>

        @* -- Tracking ----------------------------------------------------------- *@
        <MudTooltip Text="@(State.Tracking ? Loc["MountButtons_TrackingOffTooltip"] : Loc["MountButtons_TrackingOnTooltip"])"
                    Placement="Placement.Top" Arrow="true">
            <MudIconButton Icon="@Icons.Material.Filled.TrackChanges"
                           Color="Color.Primary"
                           Variant="Variant.Outlined"
                           Size="Size.Large"
                           Class="ma-2 gs-icon-button-rounded"
                           Disabled="@(!IsConnected)"
                           OnClick="OnTrackingClickAsync" />
        </MudTooltip>

        @* -- Flip SOP (GEM only) ------------------------------------------------ *@
        @if (State.IsGermanPolarMode)
        {
            <MudTooltip Text="@Loc["MountButtons_FlipTooltip"]"
                        Placement="Placement.Top" Arrow="true">
                <MudIconButton Icon="@Icons.Material.Filled.FlipCameraAndroid"
                               Color="Color.Primary"
                               Variant="Variant.Outlined"
                               Size="Size.Large"
                               Class="ma-2 gs-icon-button-rounded"
                               Disabled="@(!IsConnected || State.Slewing)"
                               OnClick="OnFlipSopClickAsync" />
            </MudTooltip>
        }

        @* -- ReSync ------------------------------------------------------------- *@
        <MudTooltip Text="@Loc["MountButtons_ReSyncTooltip"]" Placement="Placement.Top" Arrow="true">
            <MudIconButton Icon="@Icons.Material.Filled.SettingsEthernet"
                           Color="Color.Primary"
                           Variant="Variant.Outlined"
                           Size="Size.Large"
                           Class="ma-2 gs-icon-button-rounded"
                           Disabled="@(!IsConnected || State.Slewing)"
                           OnClick="OnReSyncClickAsync" />
        </MudTooltip>

        @* -- AutoHome ----------------------------------------------------------- *@
        <MudTooltip Text="@(State.IsAutoHomeRunning ? Loc["MountButtons_AutoHomeRunningTooltip"] : Loc["MountButtons_AutoHomeTooltip"])"
                    Placement="Placement.Top" Arrow="true">
            <MudIconButton Icon="@HomeSearchIcon"
                           Color="@(State.IsAutoHomeRunning ? Color.Warning : Color.Primary)"
                           Variant="Variant.Outlined"
                           Size="Size.Large"
                           Class="ma-2 gs-icon-button-rounded"
                           Disabled="@(!IsConnected || State.AtPark)"
                           OnClick="OnAutoHomeClickAsync" />
        </MudTooltip>

        @* -- Limits ------------------------------------------------------------- *@
        <MudTooltip Text="@(State.LimitsOn ? Loc["MountButtons_LimitsOffTooltip"] : Loc["MountButtons_LimitsOnTooltip"])"
                    Placement="Placement.Top" Arrow="true">
            <MudIconButton Icon="@LimitsOnIcon"
                           Color="Color.Primary"
                           Variant="Variant.Outlined"
                           Size="Size.Large"
                           Class="ma-2 gs-icon-button-rounded"
                           Disabled="@(!IsConnected)"
                           OnClick="OnLimitsClickAsync" />
        </MudTooltip>

        @* -- Settings ----------------------------------------------------------- *@
        <MudTooltip Text="@Loc["MountButtons_SettingsTooltip"]"
                    Placement="Placement.Top" Arrow="true">
            <MudIconButton Icon="@Icons.Material.Filled.Settings"
                           Color="Color.Primary"
                           Variant="Variant.Text"
                           Size="Size.Large"
                           Class="mt-1 ml-1"
                           OnClick="OnSettingsClickAsync" />
        </MudTooltip>

    </div>
}

@if (ShowStopButton)
{
    @* -- Stop (kept for any future ShowStopButton=true usage) ------------------- *@
    <MudTooltip Text="@Loc["MountButtons_StopTooltip"]" Placement="Placement.Top" Arrow="true">
        <MudIconButton Variant="Variant.Outlined" Color="Color.Error"
                       Icon="@Icons.Material.Filled.StopCircle"
                       Size="Size.Large"
                       Class="gs-icon-button-rounded"
                       Disabled="@(!State.HasEverBeenConnected && !IsConnected)"
                       OnClick="OnStopClickAsync" />
    </MudTooltip>
}
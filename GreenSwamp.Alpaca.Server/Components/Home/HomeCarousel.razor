@using GreenSwamp.Alpaca.Settings.Services
@inject IVersionedSettingsService SettingsService

@* Reads carousel.settings.json once per page load. Edits to the file appear on the next visit. *@

<MudStack Spacing="0" Class="flex-grow-1" Style="min-height:0;">
    @if (_shows.Count > 1)
    {
        <MudStack Row="true" Justify="Justify.Center" Class="gs-carousel-toggle mb-2">
            <MudToggleGroup T="string" Value="_activeId" ValueChanged="OnShowChanged"
                            Color="Color.Primary" Size="Size.Small" Outlined="true" Delimiters="true">
                @foreach (var show in _shows)
                {
                    <MudToggleItem Value="@show.Id" Text="@show.Title" />
                }
            </MudToggleGroup>
        </MudStack>
    }

    @if (_active is null)
    {
        <MudText Align="Align.Center" Class="gs-carousel-empty ma-auto">No carousel images are configured.</MudText>
    }
    else
    {
        @* @key forces a clean rebuild of the carousel (selection, timer, items) when the show changes. *@
        <MudTooltip Text="Click image to stop and start auto-scrolling" Placement="Placement.Top" Inline="false"
                    RootClass="d-flex flex-column flex-grow-1" RootStyle="min-height:0; width:100%;">
            <MudCarousel @key="_active.Id" TData="object" Class="gs-carousel rounded flex-grow-1"
                         @bind-SelectedIndex="_index"
                         AutoCycle="@_isAutoCycling"
                         @onclick="HandleClick"
                         AutoCycleTime="TimeSpan.FromSeconds(_dwellSeconds)"
                         ShowArrows="true" ShowBullets="true"
                         EnableSwipeGesture="true">
                @foreach (var slide in _active.Slides)
                {
                    <MudCarouselItem @key="slide.File" Transition="Transition.Fade" Color="Color.Transparent">
                        <MudStack HtmlTag="figure" Spacing="0" Class="gs-slide pt-2 px-14 pb-11">
                            <MudStack Row="true" Spacing="0" AlignItems="AlignItems.Center" Justify="Justify.Center"
                                      Class="flex-grow-1" Style="min-height:0;">
                                <img class="gs-slide-img" src="@ImageUrl(_active, slide)" alt="@slide.Caption"
                                     onerror="this.parentElement.classList.add('gs-slide-missing')" />
                                <span class="gs-slide-fallback">Image not found: @slide.File</span>
                            </MudStack>
                            <MudText Typo="Typo.body1" HtmlTag="figcaption" Align="Align.Center" Class="gs-slide-caption pt-2">@slide.Caption</MudText>
                        </MudStack>
                    </MudCarouselItem>
                }
            </MudCarousel>
        </MudTooltip>

        @if (_nextUrl is not null)
        {
            <img class="gs-slide-preload" src="@_nextUrl" alt="" aria-hidden="true" />
        }
    }
</MudStack>

@code {
    private List<CarouselShow> _shows = [];
    private CarouselShow? _active;
    private string _activeId = string.Empty;
    private int _dwellSeconds = CarouselSettings.DefaultDwellSeconds;
    private int _index;
    private bool _isAutoCycling = true;

    private string? _nextUrl =>
        _active is { Slides.Count: > 1 }
            ? ImageUrl(_active, _active.Slides[(Math.Max(_index, 0) + 1) % _active.Slides.Count])
            : null;

    protected override void OnInitialized()
    {
        var settings = SettingsService.GetCarouselSettings();
        _dwellSeconds = settings.DwellSeconds;

        // Only shows that actually have slides are offered.
        _shows = settings.Shows.Where(s => s.Slides.Count > 0).ToList();
        SelectShow(settings.ActiveShow);
    }

    private void SelectShow(string? id)
    {
        _active = _shows.FirstOrDefault(s => string.Equals(s.Id, id, StringComparison.OrdinalIgnoreCase))
                  ?? _shows.FirstOrDefault();
        _activeId = _active?.Id ?? string.Empty;
        _index = 0;
    }

    private async Task OnShowChanged(string? id)
    {
        SelectShow(id);
        if (_active is not null)
        {
            try
            {
                await SettingsService.SetCarouselActiveShowAsync(_active.Id);
            }
            catch (Exception ex)
            {
                // Persisting the choice is best effort; the selection still works for this visit.
                ASCOM.Alpaca.Logging.LogWarning($"Carousel active show not saved: {ex.Message}");
            }
        }
    }

    private void HandleClick()
    {
        _isAutoCycling = !_isAutoCycling;
    }

    private static string ImageUrl(CarouselShow show, CarouselSlide slide) =>
        $"images/carousel/{Uri.EscapeDataString(show.Folder)}/{Uri.EscapeDataString(slide.File)}";
}

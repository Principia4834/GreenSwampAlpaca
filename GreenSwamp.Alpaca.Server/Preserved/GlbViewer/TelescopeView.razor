@page "/telescope-view/{DeviceNumber:int}"
@layout ChartWindowLayout
@using ASCOM.Common.DeviceInterfaces
@using GreenSwamp.Alpaca.Server.Pages.Charts
@using GreenSwamp.Alpaca.Server.Services
@using GreenSwamp.Alpaca.Settings.Services
@inject TelescopeStateService StateService
@inject ActiveDeviceViewRegistry ActiveViews
@inject IVersionedSettingsService SettingsService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@Loc["TView_Title", DeviceNumber]</PageTitle>

<div style="display:flex; flex-direction:column; height:100vh; overflow:hidden; padding:8px; box-sizing:border-box;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
        <MudText Typo="Typo.subtitle1">
            @Loc.Html("TView_Header", DeviceNumber)
        </MudText>
        <MudSpacer />
        <MudText Typo="Typo.caption" Class="gs-font-mono">
            @Loc["TView_Axis1", _axisX.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)]&nbsp;&nbsp;@Loc["TView_Axis2", _axisY.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)]
        </MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Save"
                       Size="Size.Small"
                       Title="@Loc["TView_SaveView"]"
                       OnClick="SaveViewAsync" />
    </MudStack>
    <canvas id="telescopeCanvas"
            style="flex:1; width:100%; display:block; touch-action:none;" />
</div>

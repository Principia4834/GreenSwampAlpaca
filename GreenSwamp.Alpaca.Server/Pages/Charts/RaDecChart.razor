@page "/charts/radec/{DeviceNumber:int}"
@layout ChartWindowLayout
@using ApexCharts
@using Microsoft.AspNetCore.SignalR.Client

@inject IVersionedSettingsService SettingsService
@inject ChartLoggingService Logger
@inject TelescopeStateService StateService
@inject ActiveDeviceViewRegistry ActiveViews
@inject NavigationManager Nav

@implements IAsyncDisposable

<div class="gs-radec-chart" style="display:flex;flex-direction:column;height:100vh;overflow:hidden;padding:8px;box-sizing:border-box;">

    @* -- Toolbar ----------------------------------------------------------- *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2" Wrap="Wrap.Wrap">

        <MudText Typo="Typo.subtitle1" Style="white-space:nowrap;">
            @Loc.Html("Chart_RaDecHeader", AxisDisplay(_axisLabels[0]), AxisDisplay(_axisLabels[1]), Label, DeviceNumber)
        </MudText>

        <MudSpacer />

        @if (_hubInitialised && _hubState != HubConnectionState.Connected)
        {
            <MudChip T="string" Color="MudBlazor.Color.Warning" Size="MudBlazor.Size.Small" Icon="@Icons.Material.Filled.SignalWifiOff">
                @(_hubState == HubConnectionState.Reconnecting ? Loc["Chart_Reconnecting"].Value : Loc["Chart_Disconnected"].Value)
            </MudChip>
        }

        @* Window duration — only visible in Realtime mode *@
        <MudSelect T="int" Label="@Loc["Chart_DataWindow"]" Value="@_settings.RealtimeWindowSeconds"
                   ValueChanged="@OnWindowChangedAsync"
                   Disabled="@(IsHistoricalMode)"
                   Variant="Variant.Outlined" Margin="Margin.Dense"
                   Style="min-width:6.875rem;">
            <MudSelectItem Value="10">@Loc["Chart_Win10s"]</MudSelectItem>
            <MudSelectItem Value="30">@Loc["Chart_Win30s"]</MudSelectItem>
            <MudSelectItem Value="120">@Loc["Chart_Win2m"]</MudSelectItem>
            <MudSelectItem Value="300">@Loc["Chart_Win5m"]</MudSelectItem>
            <MudSelectItem Value="900">@Loc["Chart_Win15m"]</MudSelectItem>
            <MudSelectItem Value="1800">@Loc["Chart_Win30m"]</MudSelectItem>
        </MudSelect>

        <MudSelect T="string" Label="@Loc["Chart_Scale"]" Value="@_settings.RaDecScale"
                   ValueChanged="@OnScaleChangedAsync"
                   Variant="Variant.Outlined" Margin="Margin.Dense"
                   Style="min-width:8.125rem;">
            <MudSelectItem Value="@("Steps")">@Loc["Chart_Steps"]</MudSelectItem>
            <MudSelectItem Value="@("Degrees")">@Loc["Chart_Degrees"]</MudSelectItem>
            <MudSelectItem Value="@("ArcSeconds")">@Loc["Chart_ArcSeconds"]</MudSelectItem>
        </MudSelect>

        <MudTooltip Text="@(IsRealtimeMode ? Loc["Chart_PauseTip"].Value : Loc["Chart_ResumeTip"].Value)" Placement="Placement.Left">
            <MudIconButton Icon="@(IsRealtimeMode ? Icons.Material.Filled.Pause : Icons.Material.Filled.PlayArrow)"
                           Color="@(IsRealtimeMode ? MudBlazor.Color.Warning : MudBlazor.Color.Success)"
                           Variant="Variant.Outlined"
                           Size="MudBlazor.Size.Small"
                           OnClick="TogglePauseResumeAsync"
                           aria-label="@(IsRealtimeMode ? Loc["Chart_PauseAria"].Value : Loc["Chart_ResumeAria"].Value)" />
        </MudTooltip>

        <MudSwitch T="bool" Label="@AxisDisplay(_axisLabels[0])" Value="@_settings.ShowAxis1"
                   ValueChanged="@(v => OnSeriesToggleAsync(v, axis: 1))"
                   Color="MudBlazor.Color.Error" />

        <MudSwitch T="bool" Label="@AxisDisplay(_axisLabels[1])" Value="@_settings.ShowAxis2"
                ValueChanged="@(v => OnSeriesToggleAsync(v, axis: 2))"
                Color="MudBlazor.Color.Info" />

        <MudTooltip Text="@Loc["Chart_Clear"]" Placement="Placement.Left">
            <MudIconButton Icon="@Icons.Material.Filled.DeleteSweep" Color="MudBlazor.Color.Warning"
                           OnClick="ClearChartAsync" Size="MudBlazor.Size.Medium" />
        </MudTooltip>

    </MudStack>

    @* -- Chart ------------------------------------------------------------- *@
    <div style="flex:1;min-height:0;overflow:hidden;">
        <ApexChart TItem="RaDecChartData"
                    @key="@_chartKey"
                    XAxisType="XAxisType.Datetime"
                    Options="@_chartOptions"
                    @ref="_chart"
                    Height="@("100%")"
                    Width="@("100%")">

            <ApexPointSeries TItem="RaDecChartData"
                                Items="@_chartItems"
                                Name="@(AxisDisplay(_axisLabels[0]))"
                                SeriesType="SeriesType.Line"
                                XValue="@(p => p.TimestampMs)"
                                YValue="@(p => (decimal)p.Ra)"
                                Hidden="@(!_settings.ShowAxis1)"
                                Stroke="@(new SeriesStroke { Width = 2, Color = "#f44336" })" />

            <ApexPointSeries TItem="RaDecChartData"
                                Items="@_chartItems"
                                Name="@(AxisDisplay(_axisLabels[1]))"
                                SeriesType="SeriesType.Line"
                                XValue="@(p => p.TimestampMs)"
                                YValue="@(p => (decimal)p.Dec)"
                                Hidden="@(!_settings.ShowAxis2)"
                                Stroke="@(new SeriesStroke { Width = 2, Color = "#2196f3" })" />

        </ApexChart>
    </div>

</div>
@page "/charts/radec/{DeviceNumber:int}"
@layout ChartWindowLayout
@using ApexCharts
@using Microsoft.AspNetCore.SignalR.Client

@inject IVersionedSettingsService SettingsService
@inject ChartLoggingService Logger
@inject TelescopeStateService StateService
@inject ActiveDeviceViewRegistry ActiveViews
@inject NavigationManager Nav

@implements IAsyncDisposable

<div class="gs-radec-chart" style="display:flex;flex-direction:column;height:100vh;overflow:hidden;padding:8px;box-sizing:border-box;">

    @* -- Toolbar ----------------------------------------------------------- *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2" Wrap="Wrap.Wrap">

        <MudText Typo="Typo.subtitle1" Style="white-space:nowrap;">
            <b style="color:var(--gs-accent-500);">@_axisLabels[0] / @_axisLabels[1]</b> Position &mdash; @Label &mdash; Device @DeviceNumber
        </MudText>

        <MudSpacer />

        @if (_hubInitialised && _hubState != HubConnectionState.Connected)
        {
            <MudChip T="string" Color="MudBlazor.Color.Warning" Size="MudBlazor.Size.Small" Icon="@Icons.Material.Filled.SignalWifiOff">
                @(_hubState == HubConnectionState.Reconnecting ? "Reconnecting…" : "Disconnected")
            </MudChip>
        }

        @* Window duration — only visible in Realtime mode *@
        <MudSelect T="int" Label="Data Window" Value="@_settings.RealtimeWindowSeconds"
                   ValueChanged="@OnWindowChangedAsync"
                   Disabled="@(IsHistoricalMode)"
                   Variant="Variant.Outlined" Margin="Margin.Dense"
                   Style="min-width:110px;">
            <MudSelectItem Value="10">10 s</MudSelectItem>
            <MudSelectItem Value="30">30 s</MudSelectItem>
            <MudSelectItem Value="120">2 m</MudSelectItem>
            <MudSelectItem Value="300">5 m</MudSelectItem>
            <MudSelectItem Value="900">15 m</MudSelectItem>
            <MudSelectItem Value="1800">30 m</MudSelectItem>
        </MudSelect>

        <MudSelect T="string" Label="Scale" Value="@_settings.RaDecScale"
                   ValueChanged="@OnScaleChangedAsync"
                   Variant="Variant.Outlined" Margin="Margin.Dense"
                   Style="min-width:130px;">
            <MudSelectItem Value="@("Steps")">Steps</MudSelectItem>
            <MudSelectItem Value="@("Degrees")">Degrees</MudSelectItem>
            <MudSelectItem Value="@("ArcSeconds")">Arc Seconds</MudSelectItem>
        </MudSelect>

        <MudTooltip Text="@(IsRealtimeMode ? "Pause (freeze to historical snapshot)" : "Resume realtime scrolling")" Placement="Placement.Left">
            <MudIconButton Icon="@(IsRealtimeMode ? Icons.Material.Filled.Pause : Icons.Material.Filled.PlayArrow)"
                           Color="@(IsRealtimeMode ? MudBlazor.Color.Warning : MudBlazor.Color.Success)"
                           Variant="Variant.Outlined"
                           Size="MudBlazor.Size.Small"
                           OnClick="TogglePauseResumeAsync"
                           aria-label="@(IsRealtimeMode ? "Pause chart updates" : "Resume chart updates")" />
        </MudTooltip>

        <MudSwitch T="bool" Label="@_axisLabels[0]" Value="@_settings.ShowAxis1"
                   ValueChanged="@(v => OnSeriesToggleAsync(v, axis: 1))"
                   Color="MudBlazor.Color.Error" />

            <MudSwitch T="bool" Label="@_axisLabels[1]" Value="@_settings.ShowAxis2"
                   ValueChanged="@(v => OnSeriesToggleAsync(v, axis: 2))"
                   Color="MudBlazor.Color.Info" />

    </MudStack>

    @* -- Chart ------------------------------------------------------------- *@
    <div style="flex:1;min-height:0;overflow:hidden;">
        <ApexChart TItem="RaDecChartData"
                   @key="@_chartKey"
                   XAxisType="XAxisType.Datetime"
                   Options="@_chartOptions"
                   @ref="_chart"
                   Height="@("100%")"
                   Width="@("100%")">

            <ApexPointSeries TItem="RaDecChartData"
                             Items="@_chartItems"
                             Name="@(_axisLabels[0])"
                             SeriesType="SeriesType.Line"
                             XValue="@(p => p.TimestampMs)"
                             YValue="@(p => (decimal)p.Ra)"
                             Hidden="@(!_settings.ShowAxis1)"
                             Stroke="@(new SeriesStroke { Width = 2, Color = "#f44336" })" />

            <ApexPointSeries TItem="RaDecChartData"
                             Items="@_chartItems"
                             Name="@(_axisLabels[1])"
                             SeriesType="SeriesType.Line"
                             XValue="@(p => p.TimestampMs)"
                             YValue="@(p => (decimal)p.Dec)"
                             Hidden="@(!_settings.ShowAxis2)"
                             Stroke="@(new SeriesStroke { Width = 2, Color = "#2196f3" })" />

        </ApexChart>
    </div>

</div>
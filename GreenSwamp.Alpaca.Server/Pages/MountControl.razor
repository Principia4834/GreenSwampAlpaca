@page "/mount-control"
@page "/mount-control/{DeviceNumber:int}"
@using ASCOM.Common.DeviceInterfaces;
@using GreenSwamp.Alpaca.Server.Components
@using GreenSwamp.Alpaca.Server.Services
@using GreenSwamp.Alpaca.Settings.Services
@using GreenSwamp.Alpaca.MountControl
@using ASCOM.Alpaca
@inject IVersionedSettingsService SettingsService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject TelescopeStateService StateService
@implements IDisposable

<PageTitle>@Loc["MCtl_Title"]</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h3">@Loc["MCtl_Title"]</MudText>

    @if (IsActiveMountSimulator)
    {
        <MudPaper Elevation="0"
                  Class="d-flex align-center justify-center pa-1"
                  Style="background-color: var(--mud-palette-success); border-radius: 8px; flex: 0 0 33%; max-width: 33%;">
            <MudText Typo="Typo.h5" Color="Color.Default">@Loc["MC_Simulator"]</MudText>
        </MudPaper>
    }

    <MudButton Color="Color.Default"
               Variant="Variant.Outlined"
               Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Download"
               OnClick="OpenExportDialog">
        @Loc["MountCfg_Export"]
    </MudButton>
</MudStack>

@if (_alpacaDevices.Count == 0)
{
    <MudAlert Severity="Severity.Info">@Loc["MountCfg_NoDevices"]</MudAlert>
}
else
{
    <MudTabs Rounded="true" Elevation="1" Class="mb-4 gs-tabs-no-transform"
             TabPanelsClass="pt-2"
             ActivePanelIndex="@ActiveTabIndex"
             ActivePanelIndexChanged="OnDeviceTabChanged">
        @foreach (var dn in GetConfiguredDeviceNumbers())
        {
            <MudTabPanel Text="@TabLabel(dn)">
                @{
                    var s  = StateService.GetCurrentState(dn);
                    var ms = _deviceSettings.GetValueOrDefault(dn);
                    var isUiClientConnected = IsUiClientConnected(dn);
                    var mount = MountRegistry.GetInstance(dn);
                }

                @* -- Compact position header ------------------------------- *@
                <MudPaper Elevation="1" Class="pa-2 mb-2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                        <MudStack Row="true" AlignItems="AlignItems.Baseline" Spacing="1">
                            <MudText Typo="Typo.body1" Color="Color.Primary">@Loc["Coord_Ra"]</MudText>
                            <MudText Typo="Typo.h6" Class="gs-font-mono">@FormatHMS(s.RightAscension)</MudText>
                        </MudStack>
                        <MudStack Row="true" AlignItems="AlignItems.Baseline" Spacing="1">
                            <MudText Typo="Typo.body1" Color="Color.Primary">@Loc["Coord_Dec"]</MudText>
                            <MudText Typo="Typo.h6" Class="gs-font-mono">@FormatDMS(s.Declination)</MudText>
                        </MudStack>
                        <MudStack Row="true" AlignItems="AlignItems.Baseline" Spacing="1">
                            <MudText Typo="Typo.body1" Color="Color.Primary">@Loc["Coord_Az"]</MudText>
                            <MudText Typo="Typo.h6" Class="gs-font-mono">@FormatDMS(s.Azimuth)</MudText>
                        </MudStack>
                        <MudStack Row="true" AlignItems="AlignItems.Baseline" Spacing="1">
                            <MudText Typo="Typo.body1" Color="Color.Primary">@Loc["Coord_Alt"]</MudText>
                            <MudText Typo="Typo.h6" Class="gs-font-mono">@FormatDMS(s.Altitude)</MudText>
                        </MudStack>
                        <MudStack Row="true" AlignItems="AlignItems.Baseline" Spacing="1">
                            <MudText Typo="Typo.body1" Color="Color.Primary">@Loc["MCtl_Lha"]</MudText>
                            <MudText Typo="Typo.h6" Class="gs-font-mono">@FormatHMS(s.LocalHourAngle)</MudText>
                        </MudStack>
                        <MudStack Row="true" AlignItems="AlignItems.Baseline" Spacing="1">
                            <MudText Typo="Typo.body1" Color="Color.Primary">@Loc["MCtl_Lst"]</MudText>
                            <MudText Typo="Typo.h6" Class="gs-font-mono">@FormatHMS(s.LocalSiderealTime)</MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>

                @* -- State icon row ----------------------------------------- *@
                <MudPaper Elevation="1" Class="px-2 py-2 mb-3" Style="height:4rem;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center">

                        @* -- Status indicators (left) *@
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">

                            <MudTooltip Text="@(s.AtHome ? Loc["State_AtHome"].Value : Loc["State_NotAtHome"].Value)" Placement="Placement.Bottom" Arrow="true">
                                <MudIcon Icon="@Icons.Material.Filled.Home"
                                         Color="@(s.AtHome ? Color.Success : Color.Default)"
                                         Size="Size.Large" />
                            </MudTooltip>

                            <MudTooltip Text="@(s.AtPark ? Loc["State_Parked"].Value : Loc["State_Unparked"].Value)" Placement="Placement.Bottom" Arrow="true">
                                <MudIcon Icon="@Icons.Material.Filled.LocalParking"
                                         Color="@(s.AtPark ? Color.Info : Color.Default)"
                                         Size="Size.Large" />
                            </MudTooltip>

                            <MudTooltip Text="@(s.Slewing ? Loc["State_Slewing"].Value : Loc["State_Stationary"].Value)" Placement="Placement.Bottom" Arrow="true">
                                <MudIcon Icon="@Icons.Material.Filled.Moving"
                                         Color="@(s.Slewing ? Color.Warning : Color.Default)"
                                         Size="Size.Large" />
                            </MudTooltip>

                            <MudTooltip Text="@(s.Tracking ? Loc["State_TrackingWithRate", s.TrackingRate].Value : Loc["State_TrackingOff"].Value)"
                                        Placement="Placement.Bottom" Arrow="true">
                                <MudIcon Icon="@Icons.Material.Filled.TrackChanges"
                                         Color="@(s.Tracking ? Color.Success : Color.Default)"
                                         Size="Size.Large" />
                            </MudTooltip>

                            <MudTooltip Text="@(s.IsPulseGuidingDec || s.IsPulseGuidingRa ? Loc["State_PulseGuidingActive"].Value : Loc["State_PulseGuidingOff"].Value)"
                                        Placement="Placement.Bottom" Arrow="true">
                                <MudIcon Icon="@PulseIcon"
                                         Color="@(s.IsPulseGuidingDec || s.IsPulseGuidingRa ? Color.Warning : Color.Default)"
                                         Size="Size.Large" />
                            </MudTooltip>

                            <MudTooltip Text="@(s.SideOfPier == PointingState.Normal ? Loc["State_PierEast"].Value : Loc["State_PierWest"].Value)"
                                        Placement="Placement.Bottom" Arrow="true">
                                <MudIcon Icon="@(s.SideOfPier == PointingState.Normal ? Icons.Material.Filled.NorthEast : Icons.Material.Filled.NorthWest)"
                                         Color="@(s.ConnectedClientCount > 0 ? Color.Success : Color.Default)"
                                         Size="Size.Large" />
                            </MudTooltip>

                            <MudTooltip Text="@(GetLimitTootltip(s))"
                                        Placement="Placement.Bottom" Arrow="true">
                                <MudIcon Icon="@LimitsOnIcon"
                                         Color="@(GetLimitIconColor(s))"
                                         Size="Size.Large" />
                            </MudTooltip>

                            <MudTooltip Text="@(s.VoiceActive ? Loc["State_VoiceOn"].Value : Loc["State_VoiceOff"].Value)" Placement="Placement.Bottom" Arrow="true">
                                <MudIcon Color="@(isUiClientConnected ? Color.Success : Color.Default)"
                                         Icon="@(s.VoiceActive ? Icons.Material.Filled.RecordVoiceOver : Icons.Material.Filled.VoiceOverOff)"
                                         Size="Size.Large" />
                            </MudTooltip>

                            @* -- Connections --------------------------------------- *@
                            <MudTooltip Text="@(s.ConnectedClientCount > 0 ? Loc["State_ActiveConnections", s.ConnectedClientCount].Value : (s.HasEverBeenConnected ? Loc["State_NoActiveConnectionsWas"].Value : Loc["State_NoConnections"].Value))"
                                        Placement="Placement.Bottom" Arrow="true">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                                    <MudIcon Icon="@(s.ConnectedClientCount > 0 ? Icons.Material.Filled.Link : Icons.Material.Filled.LinkOff)"
                                             Color="@(s.ConnectedClientCount > 0 ? Color.Success : Color.Default)"
                                             Size="Size.Large" />
                                    <MudText Typo="Typo.h4"
                                             Color="@(s.ConnectedClientCount > 0 ? Color.Success : (s.HasEverBeenConnected ? Color.Warning : Color.Default))">
                                        : @s.ConnectedClientCount
                                    </MudText>
                                </MudStack>
                            </MudTooltip>

                        </MudStack>

                    </MudStack>
                </MudPaper>

                @* -- Inline control panels and buttons ---------------------- *@
                <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap" Class="mb-3">

                    <MudPaper Elevation="1" Class="pa-3" Style="min-width:18.75rem">
                        <GoToPanel State="@s"
                                   DeviceNumber="@dn"
                                   IsUiClientConnected="@isUiClientConnected" />
                    </MudPaper>

                    <MudPaper Elevation="1" Class="pa-3">
                        <MudText Typo="Typo.overline" Class="gs-panel-heading mb-2">@Loc["MCtl_HandController"]</MudText>
                        <HandControllerPanel DeviceNumber="@dn" IsEnabled="@isUiClientConnected" />
                    </MudPaper>

                    <MudPaper Elevation="1" Class="pa-3">
                        <MudText Typo="Typo.overline" Class="gs-panel-heading mb-2">@Loc["MCtl_MountInfo"]</MudText>
                        <MountInfo State="@s"
                                   DeviceNumber="@dn"
                                   IsConnected="@isUiClientConnected"
                                   AlignmentMode="@ms?.AlignmentMode"
                                   DeviceLabel="@TabLabel(dn)" />
                    </MudPaper>
                </MudStack>

                @* -- Bottom action bar ------------------------------------- *@
                <MudPaper Elevation="1" Class="px-2 py-2 mt-3" Style="height:4rem;">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">

                        @* Far left: Shutdown *@
                        <MudTooltip Text="@Loc["MCtl_ShutdownTip"]"
                                    Placement="Placement.Top" Arrow="true">
                            <MudIconButton Icon="@Icons.Material.Filled.PowerSettingsNew"
                                           Color="Color.Error"
                                           Size="Size.Large"
                                           Variant="Variant.Text"
                                           OnClick="OpenShutdownDialogAsync" />
                        </MudTooltip>

                        @* Centre: Stop — same StopCircle icon as the hand controller *@
                        <MudTooltip Text="@Loc["MountButtons_StopTooltip"]" Placement="Placement.Top" Arrow="true">
                            <MudIconButton Icon="@Icons.Material.Filled.StopCircle"
                                           Color="Color.Error"
                                           Size="Size.Large"
                                           Variant="Variant.Text"
                                           Disabled="@(!s.HasEverBeenConnected)"
                                           OnClick="@(() => OnStopClickAsync(dn))" />
                        </MudTooltip>

                        @* Right: Connect / Disconnect — shows spinner while connecting *@
                        @{
                            var connecting = IsConnecting(dn);
                        }
                        <MudTooltip Text="@(connecting ? Loc["MCtl_Connecting"].Value : isUiClientConnected ? Loc["MCtl_Disconnect"].Value : Loc["MCtl_Connect"].Value)"
                                    Placement="Placement.Top" Arrow="true">
                            <MudIconButton Color="@(isUiClientConnected ? Color.Error : Color.Success)"
                                           Size="Size.Large"
                                           Variant="Variant.Text"
                                           Disabled="@connecting"
                                           OnClick="@(() => OnConnectToggleAsync(dn))">
                                @if (connecting)
                                {
                                    <MudProgressCircular Indeterminate="true" Size="Size.Small"
                                                         Color="Color.Default" StrokeWidth="4" />
                                }
                                else
                                {
                                    <MudIcon Icon="@(isUiClientConnected ? Icons.Material.Filled.LinkOff : Icons.Material.Filled.Link)"
                                             Size="Size.Large" />
                                }
                            </MudIconButton>
                        </MudTooltip>

                    </MudStack>
                </MudPaper>
            </MudTabPanel>
        }
    </MudTabs>
}
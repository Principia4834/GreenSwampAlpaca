@page "/telescope-view/{DeviceNumber:int}"
@layout ChartWindowLayout
@using GreenSwamp.Alpaca.Server.Pages.Charts
@using GreenSwamp.Alpaca.Server.Services
@inject TelescopeStateService StateService
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Telescope View — Device @DeviceNumber</PageTitle>

@* -- Babylon.js from CDN (pinned version) -- *@
<script src="https://cdn.babylonjs.com/babylon.js"></script>
<script src="https://cdn.babylonjs.com/loaders/babylonjs.loaders.min.js"></script>

<div style="display:flex; flex-direction:column; height:100vh; overflow:hidden; padding:8px; box-sizing:border-box;">

    @* -- Toolbar -- *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
        <MudText Typo="Typo.subtitle1">
            <b style="color:var(--gs-accent-500);">Telescope 3D View</b>
            &mdash; Device @DeviceNumber
        </MudText>
        <MudSpacer />
        <MudText Typo="Typo.caption" Class="gs-font-mono">
            Alt: @_alt.ToString("F2")°&nbsp;&nbsp;Az: @_az.ToString("F2")°
        </MudText>
    </MudStack>

    @* -- Canvas -- *@
    <canvas id="telescopeCanvas"
            style="flex:1; width:100%; display:block; touch-action:none;" />
</div>

@code {
    [Parameter] public int DeviceNumber { get; set; }

    private IJSObjectReference? _module;
    private double _alt;
    private double _az;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Load our ES module
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/telescopeViewer.js");

        // Init Babylon scene — swap the path for your real .obj when ready
        await _module.InvokeVoidAsync("init", "telescopeCanvas", "/models/telescope.obj");

        // Subscribe to live mount data and push initial position
        StateService.StateChanged += OnStateChanged;
        await PushRotationAsync();
    }

    private void OnStateChanged(object? sender, EventArgs e)
        => InvokeAsync(async () => await PushRotationAsync());

    private async Task PushRotationAsync()
    {
        if (_module is null) return;

        var s = StateService.GetCurrentState(DeviceNumber);
        _alt = s.Altitude;
        _az = s.Azimuth;
        try
        {
            await _module.InvokeVoidAsync("updateRotation", _alt, _az);
            StateHasChanged();
        }
        // close in progress
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
    }

    /// <summary>
    /// Disposes of the telescope viewer, unsubscribing from state changes and cleaning up the JS module.
    /// </summary>
    /// <returns></returns>
    public async ValueTask DisposeAsync()
    {
        StateService.StateChanged -= OnStateChanged;

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
            // close in progress
            catch (JSDisconnectedException) { }
            catch (TaskCanceledException) { }
        }
    }
}
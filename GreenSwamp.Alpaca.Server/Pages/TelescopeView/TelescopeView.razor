@page "/telescope-view/{DeviceNumber:int}"
@layout ChartWindowLayout
@using ASCOM.Common.DeviceInterfaces
@using GreenSwamp.Alpaca.Server.Pages.Charts
@using GreenSwamp.Alpaca.Server.Services
@inject TelescopeStateService StateService
@inject ActiveDeviceViewRegistry ActiveViews
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@Loc["TView_Title", DeviceNumber]</PageTitle>

<div style="display:flex; flex-direction:column; height:100vh; overflow:hidden; padding:8px; box-sizing:border-box;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
        <MudText Typo="Typo.subtitle1">
            @Loc.Html("TView_Header", DeviceNumber)
        </MudText>
        <MudSpacer />
        <MudText Typo="Typo.caption" Class="gs-font-mono">
            @Loc["TView_Axis1", _axisX.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)]&nbsp;&nbsp;@Loc["TView_Axis2", _axisY.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)]
        </MudText>
        <MudTooltip Text="@Loc["TView_SaveView"]">
            <MudIconButton Icon="@Icons.Material.Filled.Save"
                           Size="Size.Small"
                           aria-label="@Loc["TView_SaveView"]"
                           OnClick="SaveViewAsync" />
        </MudTooltip>
        <MudTooltip Text="@Loc["TView_CenterOnMount"]">
            <MudIconButton Icon="@Icons.Material.Filled.GpsFixed"
                           Size="Size.Small"
                           aria-label="@Loc["TView_CenterOnMount"]"
                           OnClick="CenterOnMountAsync" />
        </MudTooltip>
        <MudTooltip Text="@Loc["TView_ResetCamera"]">
            <MudIconButton Icon="@Icons.Material.Filled.Restore"
                           Size="Size.Small"
                           aria-label="@Loc["TView_ResetCamera"]"
                           OnClick="ResetCameraAsync" />
        </MudTooltip>
        <MudTooltip Text="@Loc["TView_Options"]">
            <MudIconButton Icon="@Icons.Material.Filled.Settings"
                           Size="Size.Small"
                           aria-label="@Loc["TView_Options"]"
                           OnClick="OpenOptionsAsync" />
        </MudTooltip>
    </MudStack>
    <div style="zoom: 0.85">
        <CompactPositionHeader State="@StateService.GetCurrentState(DeviceNumber)" />
    </div>
    <div style="position:relative; flex:1; min-height:0;">
        <canvas id="telescopeCanvas"
                style="width:100%; height:100%; display:block; touch-action:none;" />
        <MudTooltip Text="@Loc["TView_FaceNorth"]">
            <MudButton id="telescopeHeading" Variant="Variant.Filled" Size="Size.Small"
                       aria-label="@Loc["TView_FaceNorth"]"
                       style="position:absolute; top:0.5rem; right:0.5rem; z-index:1; display:none;">
                000°
            </MudButton>
        </MudTooltip>
    </div>
</div>

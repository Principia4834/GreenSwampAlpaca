@page "/check-settings"
@page "/settings-health"
@using GreenSwamp.Alpaca.Settings.Services
@using GreenSwamp.Alpaca.Settings.Models
@using System.Net
@inject IVersionedSettingsService SettingsService
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@Loc["HealthPage_Title"]</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">@Loc["HealthPage_Title"]</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    @Loc["HealthPage_Intro"]
</MudText>

<MudGrid>
    <MudItem xs="12" lg="10" xl="8">
        <MudGrid Spacing="4">

            @* Column 1 : Health status *@
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.h6" Class="mb-3">@Loc["HealthPage_StatusTitle"]</MudText>

                @if (_loading)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <MudText Typo="Typo.body1">@Loc["HealthPage_Validating"]</MudText>
                    </MudStack>
                }
                else if (_validationResult != null)
                {
                    @if (_validationResult.IsValid)
                    {
                        <MudAlert Severity="Severity.Success" Class="mb-3">
                            @Loc.Html("HealthPage_AllValid")
                            @if (_validationResult.HasWarnings)
                            {
                                <span> @Loc["HealthPage_WarningCount", _validationResult.Warnings.Count]</span>
                            }
                        </MudAlert>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Error" Class="mb-3">
                            @Loc.Html("HealthPage_Failed", _validationResult.Errors.Count)
                        </MudAlert>
                    }

                    @if (_validationResult.HasErrors)
                    {
                        <MudText Typo="Typo.subtitle2" Color="Color.Error" Class="mb-2">
                            @Loc["HealthPage_ErrorsHeading", _validationResult.Errors.Count]
                        </MudText>
                        @foreach (var error in _validationResult.Errors)
                        {
                            <MudPaper Outlined="true" Class="mb-2 pa-3" Style="border-color: var(--mud-palette-error)">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="mb-1">
                                    <MudStack Row="true" Spacing="1">
                                        <MudChip T="string" Color="Color.Error" Size="Size.Small">@error.ErrorCode</MudChip>
                                        @if (error.DeviceNumber.HasValue)
                                        {
                                            <MudChip T="string" Color="Color.Default" Size="Size.Small">@Loc["Health_Device", error.DeviceNumber]</MudChip>
                                        }
                                    </MudStack>
                                    @if (error.IsAutoRepairable)
                                    {
                                        <MudChip T="string" Color="Color.Info" Size="Size.Small">@Loc["HealthPage_AutoRepairable"]</MudChip>
                                    }
                                </MudStack>
                                <MudText Typo="Typo.body1">@error.Message</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@Loc.Html("HealthPage_Resolution", error.Resolution)</MudText>
                            </MudPaper>
                        }
                    }

                    @if (_validationResult.HasWarnings)
                    {
                        <MudText Typo="Typo.subtitle2" Color="Color.Warning" Class="mb-2 mt-3">
                            @Loc["HealthPage_WarningsHeading", _validationResult.Warnings.Count]
                        </MudText>
                        @foreach (var warning in _validationResult.Warnings)
                        {
                            <MudPaper Outlined="true" Class="mb-2 pa-3" Style="border-color: var(--mud-palette-warning)">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="mb-1">
                                    <MudStack Row="true" Spacing="1">
                                        <MudChip T="string" Color="Color.Warning" Size="Size.Small">@warning.ErrorCode</MudChip>
                                        @if (warning.DeviceNumber.HasValue)
                                        {
                                            <MudChip T="string" Color="Color.Default" Size="Size.Small">@Loc["Health_Device", warning.DeviceNumber]</MudChip>
                                        }
                                    </MudStack>
                                    @if (warning.IsAutoRepairable)
                                    {
                                        <MudChip T="string" Color="Color.Info" Size="Size.Small">@Loc["HealthPage_AutoRepairable"]</MudChip>
                                    }
                                </MudStack>
                                <MudText Typo="Typo.body1">@warning.Message</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@Loc.Html("HealthPage_Resolution", warning.Resolution)</MudText>
                            </MudPaper>
                        }
                    }
                }
                else
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-3">
                        @Loc.Html("HealthPage_UnableToValidate")
                    </MudAlert>
                }

                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="ValidateSettings" Disabled="_loading"
                           Class="mt-2">
                    @Loc["HealthPage_Revalidate"]
                </MudButton>
            </MudItem>

            @* Column 2 : Settings files *@
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.h6" Class="mb-1">@Loc["HealthPage_FilesTitle"]</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                    <code>@_settingsFolder</code>
                </MudText>

                @if (_jsonFiles.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@Loc["HealthPage_NoFiles"]</MudText>
                }
                else
                {
                    <MudList T="string" Dense="true" Class="mb-3">
                        @foreach (var file in _jsonFiles)
                        {
                            <MudListItem Icon="@Icons.Material.Filled.Description" IconSize="Size.Small">
                                <MudText Typo="Typo.body2">@file</MudText>
                            </MudListItem>
                        }
                    </MudList>
                }

                <MudTooltip Inline="false" RootStyle="max-width:280px"
                            Text="@(!_isLocalRequest ? Loc["HealthPage_OnlyLocalTip"].Value
                                  : SettingsPathResolver.IsService ? Loc["HealthPage_ServiceTip"].Value
                                  : string.Empty)">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.FolderOpen"
                               OnClick="OpenSettingsFolder"
                               Disabled="@(!_isLocalRequest || SettingsPathResolver.IsService)">
                        @Loc["HealthPage_OpenFolder"]
                    </MudButton>
                </MudTooltip>
            </MudItem>

        </MudGrid>
    </MudItem>

    <MudItem xs="12" lg="10" xl="8">
        <MudCard Class="mt-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.Info" />
                        <MudText Typo="Typo.h6">@Loc["HealthPage_AboutTitle"]</MudText>
                    </MudStack>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="pa-0">
                <MudExpansionPanels MultiExpansion="true">

                    <MudExpansionPanel>
                        <TitleContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.FactCheck" Size="Size.Small" />
                                <MudText Typo="Typo.subtitle2">@Loc["HealthPage_WhatValidated"]</MudText>
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            <MudList T="string" Dense="true">
                                <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">@Loc.Html("HealthPage_V_File")</MudListItem>
                                <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">@Loc.Html("HealthPage_V_Device")</MudListItem>
                                <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">@Loc.Html("HealthPage_V_Sync")</MudListItem>
                            </MudList>
                        </ChildContent>
                    </MudExpansionPanel>

                    <MudExpansionPanel>
                        <TitleContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.BuildCircle" Size="Size.Small" />
                                <MudText Typo="Typo.subtitle2">@Loc["HealthPage_AutoRepairTitle"]</MudText>
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            <MudText Typo="Typo.body1" Class="mb-1">@Loc["HealthPage_AutoRepairIntro"]</MudText>
                            <MudList T="string" Dense="true">
                                <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">@Loc["HealthPage_R_Devices"]</MudListItem>
                                <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">@Loc["HealthPage_R_Names"]</MudListItem>
                                <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">@Loc["HealthPage_R_Align"]</MudListItem>
                                <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">@Loc["HealthPage_R_Mount"]</MudListItem>
                                <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">@Loc["HealthPage_R_Sync"]</MudListItem>
                            </MudList>
                        </ChildContent>
                    </MudExpansionPanel>

                    <MudExpansionPanel>
                        <TitleContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Small" />
                                <MudText Typo="Typo.subtitle2">@Loc["HealthPage_SafetyTitle"]</MudText>
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            <MudList T="string" Dense="true">
                                <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">@Loc.Html("HealthPage_S_Backup")</MudListItem>
                                <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">@Loc.Html("HealthPage_S_Validation")</MudListItem>
                                <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">@Loc.Html("HealthPage_S_Restore")</MudListItem>
                                <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">@Loc.Html("HealthPage_S_Quarantine")</MudListItem>
                            </MudList>
                        </ChildContent>
                    </MudExpansionPanel>

                    <MudExpansionPanel>
                        <TitleContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.EditNote" Size="Size.Small" />
                                <MudText Typo="Typo.subtitle2">@Loc["HealthPage_ManualTitle"]</MudText>
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            <MudText Typo="Typo.body1" Class="mb-1">@Loc["HealthPage_ManualIntro"]</MudText>
                            <MudList T="string" Dense="true">
                                <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">@Loc.Html("HealthPage_M_OpenFolder")</MudListItem>
                                <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">@Loc.Html("HealthPage_M_Edit")</MudListItem>
                                <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">@Loc["HealthPage_M_Restart"]</MudListItem>
                                <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">@Loc["HealthPage_M_Delete"]</MudListItem>
                            </MudList>
                            <MudAlert Severity="Severity.Info" Class="mt-3">
                                @Loc.Html("HealthPage_Note")
                            </MudAlert>
                        </ChildContent>
                    </MudExpansionPanel>

                </MudExpansionPanels>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private ValidationResult? _validationResult;
    private bool _loading = true;
    private string _settingsFolder = string.Empty;
    private List<string> _jsonFiles = [];
    private bool _isLocalRequest;

    protected override void OnInitialized()
    {
        var connection = HttpContextAccessor.HttpContext?.Connection;
        _isLocalRequest = connection?.RemoteIpAddress is { } remote
            && (IPAddress.IsLoopback(remote) || remote.Equals(connection.LocalIpAddress));

        LoadSettingsFolder();
        ValidateSettings();
    }

    private void LoadSettingsFolder()
    {
        var path = SettingsService.MonitorSettingsPath;
        _settingsFolder = System.IO.Path.GetDirectoryName(path) ?? path;
        RefreshFileList();
    }

    private void RefreshFileList()
    {
        if (System.IO.Directory.Exists(_settingsFolder))
        {
            _jsonFiles = System.IO.Directory.GetFiles(_settingsFolder, "*.json")
                .Select(System.IO.Path.GetFileName)
                .Where(f => f is not null)
                .Select(f => f!)
                .OrderBy(f => f)
                .ToList();
        }
        else
        {
            _jsonFiles = [];
        }
    }

    private void ValidateSettings()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            _validationResult = SettingsService.ValidateDeviceSettings(0);
        }
        catch (Exception ex)
        {
            _validationResult = new ValidationResult
            {
                IsValid = false,
                ErrorMessage = Loc["HealthPage_ValidationError", ex.Message].Value
            };
            _validationResult.Errors.Add(new ValidationError
            {
                ErrorCode    = "VALIDATION_EXCEPTION",
                Severity     = "error",
                Message      = Loc["HealthPage_UnexpectedError", ex.Message].Value,
                Resolution   = Loc["HealthPage_CheckLogs"].Value,
                IsAutoRepairable = false
            });
        }
        finally
        {
            _loading = false;
            RefreshFileList();
            StateHasChanged();
        }
    }

    private void OpenSettingsFolder()
    {
        if (!System.IO.Directory.Exists(_settingsFolder)) return;

        try
        {
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
            {
                FileName        = _settingsFolder,
                UseShellExecute = true,
                Verb            = "open"
            });
        }
        catch
        {
            // Non-critical UI operation — silently ignore
        }
    }
}

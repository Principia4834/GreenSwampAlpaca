@using Microsoft.AspNetCore.Components.Web
@namespace GreenSwamp.Alpaca.Server.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
    <link rel="stylesheet" href="css/fonts.css" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="css/site.css" rel="stylesheet" asp-append-version="true" />
    @* Diagnostics (disabled): browser console timing for page milestones and sockets.
    <script>
        // Passive diagnostics: timestamps page milestones, Blazor/SignalR sockets and negotiate calls, and JS errors.
        (function () {
            const t0 = performance.now();
            const log = (m) => console.info('[GS.Diag] ' + location.pathname + ' +' + Math.round(performance.now() - t0) + 'ms ' + m);
            window.gsDiagLog = log;
            log('head script, readyState=' + document.readyState);
            document.addEventListener('DOMContentLoaded', () => log('DOMContentLoaded'));
            window.addEventListener('load', () => log('window load'));
            window.addEventListener('error', (e) => log('window error: ' + e.message + ' at ' + e.filename + ':' + e.lineno));
            window.addEventListener('unhandledrejection', (e) => log('unhandledrejection: ' + ((e.reason && e.reason.message) || e.reason)));

            const watched = (u) => /_blazor|charthub|telescopestatehub/i.test(String(u));

            const NativeWS = window.WebSocket;
            const WrappedWS = function (url, protocols) {
                const ws = protocols === undefined ? new NativeWS(url) : new NativeWS(url, protocols);
                {
                    // Log every WebSocket (not just the watched URLs): a pending handshake to any URL can block the others.
                    const s = performance.now();
                    log('WebSocket connecting ' + url);
                    ws.addEventListener('open', () => log('WebSocket OPEN after ' + Math.round(performance.now() - s) + 'ms ' + url));
                    ws.addEventListener('error', () => log('WebSocket ERROR ' + url));
                    ws.addEventListener('close', (e) => log('WebSocket CLOSE code=' + e.code + ' reason=' + e.reason + ' ' + url));
                }
                return ws;
            };
            WrappedWS.prototype = NativeWS.prototype;
            ['CONNECTING', 'OPEN', 'CLOSING', 'CLOSED'].forEach((k) => { WrappedWS[k] = NativeWS[k]; });
            window.WebSocket = WrappedWS;

            const nativeFetch = window.fetch;
            if (nativeFetch) {
                window.fetch = function (input, init) {
                    const url = typeof input === 'string' ? input : (input && input.url);
                    if (!watched(url)) return nativeFetch.apply(this, arguments);
                    const s = performance.now();
                    log('fetch START ' + url);
                    return nativeFetch.apply(this, arguments).then(
                        (r) => { log('fetch DONE ' + r.status + ' after ' + Math.round(performance.now() - s) + 'ms ' + url); return r; },
                        (e) => { log('fetch FAILED after ' + Math.round(performance.now() - s) + 'ms ' + url + ' ' + e); throw e; });
                };
            }

            const nativeOpen = XMLHttpRequest.prototype.open;
            XMLHttpRequest.prototype.open = function (method, url) {
                if (watched(url)) {
                    const s = performance.now();
                    log('xhr ' + method + ' START ' + url);
                    this.addEventListener('loadend', () => log('xhr loadend status=' + this.status + ' after ' + Math.round(performance.now() - s) + 'ms ' + url));
                }
                return nativeOpen.apply(this, arguments);
            };
        })();
    </script>
    *@
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    @RenderBody()

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An unhandled exception has occurred. See browser dev tools for details.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="_framework/blazor.server.js"></script>
    <script src="js/profileUtils.js" asp-append-version="true"></script>
    <script src="js/floatingWindow.js" asp-append-version="true"></script>
    <script src="js/chartWindowInterop.js" asp-append-version="true"></script>
    <script src="js/gsChartBuffer.js" asp-append-version="true"></script>
    <script>
            // Lazily inject Babylon scripts once, and ensure all callers await the same load.
            window._babylonLoadPromise = window._babylonLoadPromise || null;

            window.ensureBabylonLoaded = function() {
                if (window._babylonLoadPromise) {
                    // window.gsDiagLog && window.gsDiagLog('ensureBabylonLoaded: already started, awaiting existing promise');
                    return window._babylonLoadPromise;
                }
                // window.gsDiagLog && window.gsDiagLog('ensureBabylonLoaded: starting');

                const urls = [
                    '/lib/babylon/babylon.js',
                    '/lib/babylon/materialsLibrary/babylonjs.materials.min.js',
                    '/lib/babylon/loaders/babylonjs.loaders.min.js'
                ];

                const loadScript = (src) => new Promise((resolve, reject) => {
                    let s = document.querySelector(`script[src="${src}"]`);

                    if (!s) {
                        s = document.createElement('script');
                        s.src = src;
                        s.async = false;
                        s.dataset.gsBabylon = 'pending';
                        document.head.appendChild(s);
                    }

                    if (s.dataset.gsBabylon === 'loaded') {
                        resolve();
                        return;
                    }

                    const onLoad = () => {
                        s.dataset.gsBabylon = 'loaded';
                        // window.gsDiagLog && window.gsDiagLog('Babylon script loaded ' + src);
                        cleanup();
                        resolve();
                    };

                    const onError = () => {
                        // window.gsDiagLog && window.gsDiagLog('Babylon script FAILED ' + src);
                        cleanup();
                        reject(new Error('Failed to load: ' + src));
                    };

                    const cleanup = () => {
                        s.removeEventListener('load', onLoad);
                        s.removeEventListener('error', onError);
                    };

                    s.addEventListener('load', onLoad, { once: true });
                    s.addEventListener('error', onError, { once: true });
                });

                window._babylonLoadPromise = (async () => {
                    for (const src of urls) {
                        await loadScript(src);
                    }

                    if (!window.BABYLON || !window.BABYLON.Engine) {
                        throw new Error('Babylon runtime loaded scripts but BABYLON global is unavailable.');
                    }
                })();

                return window._babylonLoadPromise;
            };
    </script>
</body>
</html>

@page "/mount-status"
@page "/mount-status/{DeviceNumber:int}"
@using GreenSwamp.Alpaca.Server.Components
@using GreenSwamp.Alpaca.Server.Components.ButtonBar
@using GreenSwamp.Alpaca.Server.Services
@using GreenSwamp.Alpaca.MountControl
@using GreenSwamp.Alpaca.Settings.Services
@using ASCOM.Alpaca
@using System.Globalization
@inject TelescopeStateService StateService
@inject IVersionedSettingsService SettingsService
@inject IDialogService DialogService
@inject FloatingWindowManager FloatingWindowManager
@implements IDisposable

<PageTitle>Mount Status</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h3">Mount Status</MudText>

    @if (IsActiveMountSimulator)
    {
        <MudPaper Elevation="0"
                  Class="d-flex align-center justify-center pa-1"
                  Style="background-color: var(--mud-palette-success); border-radius: 8px; flex: 0 0 33%; max-width: 33%;">
            <MudText Typo="Typo.h5" Color="Color.Default">Simulator</MudText>
        </MudPaper>
    }

    <MudStack Row="true" Spacing="2">
        <MudButton Color="Color.Default"
                   Variant="Variant.Outlined"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Download"
                   OnClick="OpenExportDialog">
            Export Settings & Logs
        </MudButton>
    </MudStack>
</MudStack>

@if (_alpacaDevices.Count == 0)
{
    <MudAlert Severity="Severity.Info">No mount devices registered.</MudAlert>
}
else
{
    <MudTabs Rounded="true" Elevation="1" Class="mb-4 gs-tabs-no-transform"
             ActivePanelIndex="@ActiveTabIndex"
             ActivePanelIndexChanged="OnDeviceTabChanged">
        @foreach (var dn in GetConfiguredDeviceNumbers())
        {
            <MudTabPanel Text="@TabLabel(dn)">
                @{
                    var s = StateService.GetCurrentState(dn);
                    var mountSettings = _deviceSettings.GetValueOrDefault(dn);
                }

                <MudGrid Spacing="3" Class="mt-1">

                    @* -- Row 1: Pointing Coordinates | Axis Positions | Status ------------- *@

                    <MudItem xs="12" md="4">
                        <MudPaper Elevation="0" Class="pa-3">
                            <MudText Typo="Typo.overline" Class="gs-panel-heading mb-2">Pointing Coordinates</MudText>
                            <MudSimpleTable Dense="true" Elevation="0">
                                <tbody>
                                    <tr>
                                        <td style="width:3.125rem" class="gs-kv-label">RA</td>
                                        <td class="gs-font-mono">@FormatHMS(s.RightAscension)</td>
                                    </tr>
                                    <tr>
                                        <td class="gs-kv-label">Dec</td>
                                        <td class="gs-font-mono">@FormatDMS(s.Declination)</td>
                                    </tr>
                                    <tr>
                                        <td class="gs-kv-label">Alt</td>
                                        <td class="gs-font-mono">@FormatDMS(s.Altitude)</td>
                                    </tr>
                                    <tr>
                                        <td class="gs-kv-label">Az</td>
                                        <td class="gs-font-mono">@FormatDMS(s.Azimuth)</td>
                                    </tr>
                                    <tr>
                                        <td class="gs-kv-label">LHA</td>
                                        <td class="gs-font-mono">@FormatHMS(s.LocalHourAngle)</td>
                                    </tr>
                                    <tr>
                                        <td class="gs-kv-label">Pier</td>
                                        <td class="gs-font-mono">@s.SideOfPier</td>
                                    </tr>
                                </tbody>
                            </MudSimpleTable>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudPaper Elevation="0" Class="pa-3">
                            <MudText Typo="Typo.overline" Class="gs-panel-heading mb-2">Axis Positions</MudText>
                            <MudSimpleTable Dense="true" Elevation="0">
                                <tbody>
                                    <tr>
                                        <td style="width:5.625rem" class="gs-kv-label">Actual X</td>
                                        <td class="gs-font-mono">@FormatDegrees(s.ActualAxisX)</td>
                                    </tr>
                                    <tr>
                                        <td class="gs-kv-label">Actual Y</td>
                                        <td class="gs-font-mono">@FormatDegrees(s.ActualAxisY)</td>
                                    </tr>
                                    <tr>
                                        <td class="gs-kv-label">App X</td>
                                        <td class="gs-font-mono">@FormatDegrees(s.AppAxisX)</td>
                                    </tr>
                                    <tr>
                                        <td class="gs-kv-label">App Y</td>
                                        <td class="gs-font-mono">@FormatDegrees(s.AppAxisY)</td>
                                    </tr>
                                    <tr>
                                        <td class="gs-kv-label">Steps X</td>
                                        <td class="gs-font-mono">@s.AxisSteps[0].ToString("N0")</td>
                                    </tr>
                                    <tr>
                                        <td class="gs-kv-label">Steps Y</td>
                                        <td class="gs-font-mono">@s.AxisSteps[1].ToString("N0")</td>
                                    </tr>
                                </tbody>
                            </MudSimpleTable>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudPaper Elevation="0" Class="pa-3">
                            <MudText Typo="Typo.overline" Class="gs-panel-heading mb-2">Status</MudText>
                            <MudSimpleTable Dense="true" Elevation="0">
                                <tbody>
                                    @StatusTableRowWithDetail(
                                        "Mount Connected",
                                        s.IsMountRunning,
                                        mountSettings?.Mount == "SkyWatcher" ? (s.ComPort ?? string.Empty) : string.Empty,
                                        Color.Success)
                                    @ActiveClientsTableRow(s.ConnectedClientCount, s.HasEverBeenConnected)
                                    @StatusTableRow("Slewing", s.Slewing, Color.Warning)
                                    @StatusTableRowWithDetail(
                                        "Pulse Guiding",
                                        s.IsPulseGuidingRa || s.IsPulseGuidingDec,
                                        (s.IsPulseGuidingRa ? "RA" : string.Empty) +
                                        (s.IsPulseGuidingRa && s.IsPulseGuidingDec ? " " : string.Empty) +
                                        (s.IsPulseGuidingDec ? "DEC" : string.Empty),
                                        Color.Warning)
                                    @StatusTableRowWithDetail("Tracking", s.Tracking, s.TrackingRate.ToString(), Color.Success)
                                    @StatusTableRow("Limits On", s.LimitsOn, Color.Success)
                                    @StatusTableRow("Limit Warning", s.LimitWarningActive, Color.Warning)
                                    @StatusTableRow("At Park", s.AtPark, Color.Info)
                                    @StatusTableRow("At Home", s.AtHome, Color.Info)
                                </tbody>
                            </MudSimpleTable>
                        </MudPaper>
                    </MudItem>
                    @* -- Row 2: Primary Mount Info | Additional Mount Info (room for 1 more panel) ------ *@

                    <MudItem xs="12" md="4">
                        <MudPaper Elevation="0" Class="pa-3">
                            <MudText Typo="Typo.overline" Class="gs-panel-heading mb-2">Mount</MudText>
                            <MudSimpleTable Dense="true" Elevation="0">
                                <tbody>
                                    <tr>
                                        <td style="width:9.375rem" class="gs-kv-label">Type</td>
                                        <td>@(mountSettings?.Mount ?? "—")</td>
                                    </tr>
                                    <tr>
                                        <td class="gs-kv-label">Mode</td>
                                        <td>@(mountSettings?.AlignmentMode ?? "—")</td>
                                    </tr>
                                    <tr>
                                        <td class="gs-kv-label">Mount Model</td>
                                        <td class="gs-font-mono">@s.MountName</td>
                                    </tr>
                                    <tr>
                                        <td class="gs-kv-label">Mount Firmware</td>
                                        <td class="gs-font-mono">@s.MountVersion[0] / @s.MountVersion[1]</td>
                                    </tr>
                                    <tr>
                                        <td class="gs-kv-label">Advanced Commands</td>
                                        <td class="gs-font-mono">@BoolToSupported(s.CanAdvancedCmdSupport)</td>
                                    </tr>
                                    <tr>
                                        <td class="gs-kv-label">Home Sensor</td>
                                        <td class="gs-font-mono">@BoolToSupported(s.CanHomeSensor)</td>
                                    </tr>
                                    <tr>
                                        <td class="gs-kv-label">PPEC</td>
                                        <td class="gs-font-mono">@BoolToSupported(s.CanPPec)</td>
                                    </tr>
                                </tbody>
                            </MudSimpleTable>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudPaper Elevation="0" Class="pa-3">
                            <MudText Typo="Typo.overline" Class="gs-panel-heading mb-2">Mount</MudText>
                            <MudSimpleTable Dense="true" Elevation="0">
                                <tbody>
                                    @if (mountSettings?.Mount == "SkyWatcher")
                                    {
                                        <tr>
                                            <td class="gs-kv-label">Voltage</td>
                                            <td class="gs-font-mono">@(double.IsNaN(s.ControllerVoltage) ? "—" : $"{s.ControllerVoltage:F2} V")</td>
                                        </tr>
                                        <tr>
                                            <td class="gs-kv-label">Power Event</td>
                                            <td>@BoolIcon(s.LowVoltageEvent, Color.Error)</td>
                                        </tr>
                                    }
                                    <tr>
                                        <td class="gs-kv-label">Polar LED</td>
                                        <td class="gs-font-mono">@BoolToSupported(s.CanPolarLed)</td>
                                    </tr>
                                    <tr>
                                        <td class="gs-kv-label">Capabilities</td>
                                        <td class="gs-font-mono">@s.Capabilities</td>
                                    </tr>
                                    <tr>
                                        <td class="gs-kv-label">Custom Offset RA</td>
                                        <td class="gs-font-mono">@s.TrackingOffsetRate.X.ToString("N0")</td>
                                    </tr>
                                    <tr>
                                        <td class="gs-kv-label">Custom Offset Dec</td>
                                        <td class="gs-font-mono">@s.TrackingOffsetRate.Y.ToString("N0")</td>
                                    </tr>

                                </tbody>
                            </MudSimpleTable>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudPaper Elevation="0" Class="pa-3">
                            <MudText Typo="Typo.overline" Class="gs-panel-heading mb-2">Mount</MudText>
                            <MudSimpleTable Dense="true" Elevation="0">
                                <tbody>
                                    <tr>
                                        <td class="gs-kv-label">Steps RA</td>
                                        <td class="gs-font-mono">@s.StepsPerRevolution[0].ToString("N0")</td>
                                    </tr>
                                    <tr>
                                        <td class="gs-kv-label">Steps Dec</td>
                                        <td class="gs-font-mono">@s.StepsPerRevolution[1].ToString("N0")</td>
                                    </tr>
                                    <tr>
                                        <td class="gs-kv-label">Worm Steps RA</td>
                                        <td class="gs-font-mono">@s.StepsWormPerRevolution[0].ToString("N0")</td>
                                    </tr>
                                    <tr>
                                        <td class="gs-kv-label">Worm Steps Dec</td>
                                        <td class="gs-font-mono">@s.StepsWormPerRevolution[1].ToString("N0")</td>
                                    </tr>
                                    <tr>
                                        <td class="gs-kv-label">Frequency RA</td>
                                        <td class="gs-font-mono">@s.StepsTimeFreq[0].ToString("N0")</td>
                                    </tr>
                                    <tr>
                                        <td class="gs-kv-label">Frequency Dec</td>
                                        <td class="gs-font-mono">@s.StepsTimeFreq[1].ToString("N0")</td>
                                    </tr>
                                    <tr>
                                        <td class="gs-kv-label">RA Steps/ArcSec</td>
                                        <td class="gs-font-mono">@StepsToArcSecs(s.StepsPerRevolution[0])</td>
                                    </tr>
                                    <tr>
                                        <td class="gs-kv-label">Dec Steps/ArcSec</td>
                                        <td class="gs-font-mono">@StepsToArcSecs(s.StepsPerRevolution[1])</td>
                                    </tr>

                                </tbody>
                            </MudSimpleTable>
                        </MudPaper>
                    </MudItem>

                    @* -- Row 3: Axis Dials ---------------------------------- *@

                    <MudItem xs="12">
                        <MudPaper Elevation="0" Class="pa-3">
                            <MudText Typo="Typo.overline" Class="gs-panel-heading mb-2">Axis Dials</MudText>
                            <MudStack Row="true" Justify="Justify.FlexStart" Spacing="6" Class="mt-1">
                                <AxisDial Angle="@s.Azimuth" Label="Azimuth" Size="180" />
                                <AxisDial Angle="@s.Altitude" Label="Altitude" Size="180" />
                                <AxisDial Angle="@(s.RightAscension * 15)" Label="Right Ascension"
                                          DisplayUnits="DialDisplayUnits.Hours" Size="180" />
                                <AxisDial Angle="@s.Declination" Label="Declination" Size="180" />
                            </MudStack>
                        </MudPaper>
                    </MudItem>

                </MudGrid>
            </MudTabPanel>
        }
    </MudTabs>
}

@code {
    private RenderFragment BoolIcon(bool value, Color trueColor) => __builder =>
    {
        <MudIcon Icon="@(value ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                 Color="@(value ? trueColor : Color.Default)"
                 Size="Size.Small" />
        ;
    };

    private RenderFragment StatusTableRow(string label, bool value, Color trueColor) => __builder =>
    {
        <tr>
            <td>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    @BoolIcon(value, trueColor)
                    <MudText Typo="Typo.body2">@label</MudText>
                </MudStack>
            </td>
            <td></td>
        </tr>
        ;
    };

    private RenderFragment StatusTableRowWithDetail(string label, bool value, string detail, Color trueColor) => __builder =>
    {
        <tr>
            <td>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    @BoolIcon(value, trueColor)
                    <MudText Typo="Typo.body2">@label</MudText>
                </MudStack>
            </td>
            <td>
                @if (!string.IsNullOrWhiteSpace(detail))
                {
                    <MudText Typo="Typo.body2" Color="Color.Success" Class="gs-font-mono">@detail</MudText>
                }
            </td>
        </tr>
        ;
    };

    private RenderFragment ActiveClientsTableRow(int count, bool hasEverBeenConnected) => __builder =>
    {
        var countColor = count > 0 ? Color.Success : (hasEverBeenConnected ? Color.Warning : Color.Default);

        <tr>
            <td>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.People"
                             Color="@(count > 0 ? Color.Success : Color.Default)"
                             Size="Size.Small" />
                    <MudText Typo="Typo.body2">Active clients</MudText>
                </MudStack>
            </td>
            <td>
                <MudText Typo="Typo.body2" Class="gs-font-mono" Color="@countColor">@count</MudText>
            </td>
        </tr>
        ;
    };
}
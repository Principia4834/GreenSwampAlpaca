@using GreenSwamp.Alpaca.MountControl
@using GreenSwamp.Alpaca.Shared

<PageTitle>@Loc["TS_PageTitle", InstanceID]</PageTitle>

@* Removed the redundant page subheading — main page title is handled elsewhere *@

@if (ASCOM.Alpaca.DeviceManager.Telescopes.ContainsKey(InstanceID))
{
    var instance = MountRegistry.GetInstance(InstanceID);
    if (instance != null)
    {
        var settings = instance.Settings;

        <MudGrid Spacing="3" Class="mb-4">

            @* -- Device Information ------------------------------------- *@
            <MudItem xs="12" md="6">
                <MudCard>
                    <MudCardHeader Style="padding:8px 16px 2px 16px; margin-bottom:6px;">
                        <CardHeaderContent>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary" />
                                <MudText Typo="Typo.body1">@Loc["TS_DeviceInformation"]</MudText>
                            </MudStack>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Style="padding-top:6px;">
                                <MudSimpleTable Dense="true" Hover="true" Class="ts-table">
                                    <tbody>
                                        <tr><th>@Loc["TS_DeviceNumber"]</th><td>@InstanceID</td></tr>
                                        <tr><th>@Loc["TS_DeviceName"]</th><td>@instance.DeviceName</td></tr>
                                        <tr><th>@Loc["TS_MountType"]</th><td>@settings.Mount</td></tr>
                                        <tr><th>@Loc["TS_AlignmentMode"]</th><td>@settings.AlignmentMode</td></tr>
                                        <tr>
                                            <th>@Loc["TS_ConnectionStatus"]</th>
                                            <td>
                                                <MudText Typo="Typo.body2" Color="@(instance.IsConnected ? Color.Success : Color.Default)">@(instance.IsConnected ? Loc["TS_Connected"].Value : Loc["TS_Disconnected"].Value)</MudText>
                                            </td>
                                        </tr>
                                    </tbody>
                                </MudSimpleTable>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            @* -- Observatory Settings ----------------------------------- *@
            <MudItem xs="12" md="6">
                <MudCard>
                    <MudCardHeader Style="padding:8px 16px 2px 16px; margin-bottom:6px;">
                        <CardHeaderContent>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Color="Color.Success" />
                                <MudText Typo="Typo.body1">@Loc["TS_ObservatorySettings"]</MudText>
                            </MudStack>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Style="padding-top:6px;">
                        <MudSimpleTable Dense="true" Hover="true" Class="ts-table">
                            <tbody>
                                <tr><th>@Loc["Common_Latitude"]</th><td>@settings.Latitude.ToString("F6", System.Globalization.CultureInfo.InvariantCulture)°</td></tr>
                                <tr><th>@Loc["Common_Longitude"]</th><td>@settings.Longitude.ToString("F6", System.Globalization.CultureInfo.InvariantCulture)°</td></tr>
                                <tr><th>@Loc["TS_Elevation"]</th><td>@settings.Elevation m</td></tr>
                                <tr>
                                    <th>@Loc["TS_Refraction"]</th>
                                    <td>
                                        @if (settings.Refraction)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Close" Color="Color.Default" />
                                        }
                                    </td>
                                </tr>
                                @if (!string.IsNullOrWhiteSpace(settings.GpsComPort))
                                {
                                    <tr><th>@Loc["Obs_GpsPort"]</th><td>@settings.GpsComPort</td></tr>
                                    <tr><th>@Loc["Obs_GpsBaud"]</th><td>@((int)settings.GpsBaudRate)</td></tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            @* -- Serial Port Settings ----------------------------------- *@
            <MudItem xs="12" md="6">
                <MudCard>
                    <MudCardHeader Style="padding:8px 16px 2px 16px; margin-bottom:6px;">
                        <CardHeaderContent>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.SettingsInputHdmi" Color="Color.Warning" />
                                <MudText Typo="Typo.body1">@Loc["TS_SerialPortSettings"]</MudText>
                            </MudStack>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Style="padding-top:6px;">
                                <MudSimpleTable Dense="true" Hover="true" Class="ts-table">
                                    <tbody>
                                        <tr><th>@Loc["TS_Port"]</th><td>@settings.Port</td></tr>
                                        <tr><th>@Loc["TS_BaudRate"]</th><td>@settings.BaudRate</td></tr>
                                        <tr><th>@Loc["TS_DataBits"]</th><td>@settings.DataBits</td></tr>
                                        <tr><th>@Loc["TS_ReadTimeout"]</th><td>@settings.ReadTimeout ms</td></tr>
                                    </tbody>
                                </MudSimpleTable>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            @* -- Tracking Settings ----------------------------------------- *@
            <MudItem xs="12" md="6">
                <MudCard>
                    <MudCardHeader Style="padding:8px 16px 2px 16px; margin-bottom:6px;">
                        <CardHeaderContent>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.TrackChanges" Color="Color.Info" />
                                <MudText Typo="Typo.body1">@Loc["TS_TrackingGuiding"]</MudText>
                            </MudStack>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Style="padding-top:6px;">
                                <MudSimpleTable Dense="true" Hover="true" Class="ts-table">
                                    <tbody>
                                        <tr>
                                            <th>@Loc["TS_AutoTrackUnpark"]</th>
                                            <td>
                                                @if (settings.TrackAfterUnpark)
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" />
                                                }
                                                else
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Close" Color="Color.Default" />
                                                }
                                            </td>
                                        </tr>
                                        <tr><th>@Loc["TS_TrackingRate"]</th><td>@settings.TrackingRate</td></tr>
                                        <tr><th>@Loc["TS_SiderealRate"]</th><td>@settings.SiderealRate.ToString("F7")"/sec</td></tr>
                                        @* Refraction moved to Observatory Settings *@
                                        <tr><th>@Loc["TS_MinPulseRa"]</th><td>@settings.MinPulseRa ms</td></tr>
                                        <tr><th>@Loc["TS_MinPulseDec"]</th><td>@settings.MinPulseDec ms</td></tr>
                                    </tbody>
                                </MudSimpleTable>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            @* Row 3: Mount Settings and Telescope Optics --------------- *@
            <MudItem xs="12" md="6">
                <MudCard>
                    <MudCardHeader Style="padding:8px 16px 2px 16px; margin-bottom:6px;">
                        <CardHeaderContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Tune" />
                                <MudText Typo="Typo.h6">@Loc["TS_MountSettings"]</MudText>
                            </MudStack>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Style="padding-top:6px;">
                                <MudSimpleTable Dense="true" Hover="true" Class="ts-table">
                            <tbody>
                                <tr><th>@Loc["TS_RaBacklash"]</th><td>@settings.RaBacklash</td></tr>
                                <tr><th>@Loc["TS_DecBacklash"]</th><td>@settings.DecBacklash</td></tr>
                                <tr><th>@Loc["TS_Encoders"]</th><td>@if (settings.Encoders) { <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" /> } else { <MudIcon Icon="@Icons.Material.Filled.Close" Color="Color.Default" /> }</td></tr>
                                <tr><th>@Loc["TS_AllowAdvanced"]</th><td>@if (settings.AllowAdvancedCommandSet) { <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" /> } else { <MudIcon Icon="@Icons.Material.Filled.Close" Color="Color.Default" /> }</td></tr>
                            </tbody>
                        </MudSimpleTable>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudCard>
                    <MudCardHeader Style="padding:8px 16px 2px 16px; margin-bottom:6px;">
                        <CardHeaderContent>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Visibility" />
                                <MudText Typo="Typo.body1">@Loc["TS_TelescopeOptics"]</MudText>
                            </MudStack>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Style="padding-top:6px;">
                                <MudSimpleTable Dense="true" Hover="true" Class="ts-table">
                            <tbody>
                                <tr><th>@Loc["TS_ApertureDiameter"]</th><td>@settings.ApertureDiameter m</td></tr>
                                <tr><th>@Loc["TS_ApertureArea"]</th><td>@settings.ApertureArea m²</td></tr>
                                <tr><th>@Loc["TS_FocalLength"]</th><td>@settings.FocalLength m</td></tr>
                            </tbody>
                        </MudSimpleTable>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        @* Profile message and Back button removed per UI cleanup request *@
    }
    else
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">
            <MudText Typo="Typo.h6">@Loc["TS_InstanceNotFound"]</MudText>
            @Loc["TS_InstanceNotFoundBody", InstanceID]
        </MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.ArrowBack"
                   Href="/device-manager">@Loc["TS_BackToManager"]</MudButton>
    }
}
else
{
    <MudAlert Severity="Severity.Warning" Class="mb-3">
        <MudText Typo="Typo.h6">@Loc["TS_DeviceNotFound"]</MudText>
        @Loc["TS_DeviceNotFoundBody", InstanceID]
    </MudAlert>
    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.ArrowBack"
               Href="/device-manager">@Loc["TS_BackToManager"]</MudButton>
}

@code {
    [Parameter]
    public int InstanceID { get; set; }
}

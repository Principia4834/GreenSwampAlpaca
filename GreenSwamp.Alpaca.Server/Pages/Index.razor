@page "/"
@using GreenSwamp.Alpaca.Settings.Models
@using GreenSwamp.Alpaca.Server.Components.Home
@inject GreenSwamp.Alpaca.Server.Services.BrowserTtsService Tts

<PageTitle>@Loc["Home_PageTitle"]</PageTitle>

<div class="gs-home-hero-wrap">
<MudStack Spacing="0" Justify="Justify.SpaceBetween" Class="gs-home-hero rounded">
    <div class="gs-home-content pt-8 px-10 pb-4">
        <MudText Typo="Typo.h1" Align="Align.Center" Class="gs-home-title mb-6">
            @Loc.Html("Home_Welcome")
        </MudText>
    </div>

    <MudStack Spacing="0" Class="gs-home-carousel-area flex-grow-1 px-10 pb-4">
        <HomeCarousel />
    </MudStack>

    <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="gs-home-bottom-bar pt-3 px-4 pb-2">
        <HomeDeviceBar />
        <MudText Typo="Typo.h2" HtmlTag="p" Class="gs-home-footer-text">@Loc["Home_Footer"]</MudText>
    </MudStack>
</MudStack>
</div>
